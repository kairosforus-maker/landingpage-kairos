---
import Button from '../ui/Button.astro';
import { getLangFromUrl, content } from '../../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = content[lang].services;
const exampleLabel = lang === 'es' ? 'Ejemplo' : 'Example';

const serviceImages = [
  {
    src: 'https://images.unsplash.com/photo-1544027993-37dbfe43562a?auto=format&fit=crop&w=800&q=80',
    alt: 'Sesión de coaching personal',
    label: lang === 'es' ? 'Sesión 1:1 · Coaching personal' : '1:1 Session · Personal coaching',
  },
  {
    src: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=800&q=80',
    alt: 'Taller grupal de estrategia',
    label: lang === 'es' ? 'Taller grupal · Equipos alineados' : 'Group workshop · Aligned teams',
  },
  {
    src: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=800&q=80',
    alt: 'Desarrollo web con propósito',
    label: lang === 'es' ? 'Desarrollo web · Plataformas' : 'Web dev · Platforms',
  },
];

const services = [
  { data: t.builder, variant: 'light', image: serviceImages[0] },
  { data: t.community, variant: 'dark', image: serviceImages[1] },
  { data: t.web, variant: 'light', image: serviceImages[2] },
];
---

<section id="servicios" class="services section-padding">
  <div class="services-header">
    <span class="tag-subtitle">{t.tag}</span>
    <h2 class="section-title">{t.title}</h2>
    <p class="section-text">{t.desc}</p>
  </div>

  <div class="services-grid">
    {services.map((s) => (
      <div class={`service-card ${s.variant}-card`}>
        <!-- Image area -->
        <div class={`card-image-area ${s.variant}-image-area`}>
          <img
            src={s.image.src}
            alt={s.image.alt}
            class="card-image"
            loading="lazy"
          />
          <span class="card-image-label">{s.image.label}</span>
        </div>
        <!-- Organic curve transition -->
        <div class={`card-curve ${s.variant}-curve`}></div>
        <!-- Content -->
        <div class="card-body">
          <div class="card-number">{s.data.number}</div>
          <h3 class="card-title">{s.data.title}</h3>
          <p class="card-subtitle">{s.data.subtitle}</p>
          <p class="card-text">{s.data.desc}</p>

          <div class={`card-example ${s.variant}-example`}>
            <span class="example-label">{exampleLabel}</span>
            <p>{s.data.example}</p>
          </div>

          <div class="tags-container">
            {s.data.tags.map(tag => (
              <span class={`tag tag-${s.variant}`}>{tag}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="services-action">
    <Button href="https://api.whatsapp.com/send?phone=573133024941&text=Hola%20Kairos%2C%20estoy%20buscando%20claridad%20en%20mi%20siguiente%20paso.%20Me%20gustar%C3%ADa%20conversar%20con%20ustedes." external variant="primary">
      {t.community.btn}
    </Button>
  </div>
</section>

<style>
  .services {
    background-color: var(--color-dark);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
  }

  .services-header {
    text-align: center;
    max-width: 800px;
  }

  .tag-subtitle {
    font-family: var(--font-heading);
    color: var(--color-primary);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
  }

  .section-title {
    font-size: clamp(2.18rem, 4vw, 3rem);
    margin-bottom: 1.5rem;
    color: var(--color-white);
  }

  .section-text {
    font-size: clamp(1.06rem, 2vw, 1.25rem);
    color: #a0a0a0;
    line-height: 1.6;
  }

  .services-grid {
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
    max-width: 1200px;
  }

  .service-card {
    flex: 1;
    min-width: 320px;
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: none;
    border: 2px solid transparent;
  }

  .service-card:hover {
    transform: none;
  }

  .light-card {
    background-color: var(--color-white);
  }

  .dark-card {
    background-color: #0A0A0A;
    color: var(--color-light);
  }

  /* Image area */
  .card-image-area {
    position: relative;
    height: 220px;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .service-card:hover .card-image {
    transform: none;
  }

  .card-image-label {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(10, 10, 10, 0.7);
    backdrop-filter: blur(8px);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 6px 14px;
    border-radius: 99px;
  }

  /* Organic curve */
  .card-curve {
    height: 32px;
    margin-top: -32px;
    position: relative;
    z-index: 1;
    border-radius: 32px 32px 0 0;
  }

  .light-curve {
    background: var(--color-white);
  }

  .dark-curve {
    background: #0A0A0A;
  }

  /* Card body */
  .card-body {
    padding: 1rem 2.5rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
  }

  .card-number {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-primary);
    letter-spacing: 2px;
    margin-bottom: 0.75rem;
  }

  .card-title {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .light-card .card-title {
    color: var(--color-dark);
  }
  .dark-card .card-title {
    color: var(--color-white);
  }

  .card-subtitle {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-primary);
    margin-bottom: 2rem;
  }

  .card-text {
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
    max-width: 90%;
  }

  .card-example {
    text-align: left;
    border-radius: 14px;
    padding: 1.1rem 1.35rem;
    margin-bottom: 2rem;
    width: 100%;
    max-width: 95%;
    border-left: 3px solid var(--color-primary);
  }

  .light-example {
    background-color: #FAF6F2;
  }

  .dark-example {
    background-color: rgba(255, 77, 0, 0.07);
  }

  .example-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.4rem;
  }

  .card-example p {
    font-size: 0.98rem;
    line-height: 1.55;
    font-style: italic;
  }

  .light-example p {
    color: #444;
  }

  .dark-example p {
    color: #D8D8D8;
  }

  .light-card .card-text {
    color: #222;
  }
  .dark-card .card-text {
    color: #FFF;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    max-width: 95%;
  }

  .tag {
    padding: 0.4rem 1.25rem;
    border: 1px solid;
    border-radius: 99px;
    font-size: 0.95rem;
    font-weight: 400;
  }

  .tag-light {
    border-color: #333;
    color: #333;
  }

  .tag-dark {
    border-color: #FFF;
    color: #FFF;
  }

  .services-action {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }
</style>
