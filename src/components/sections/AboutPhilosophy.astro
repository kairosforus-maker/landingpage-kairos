---
import { getLangFromUrl, content } from '../../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = content[lang].about.philosophy;
const manifesto = content[lang].about.manifesto;
---

<section class="about-philosophy section-padding">
  <div class="philosophy-container">
    <div class="philosophy-text-col anim-slide-left">
      <span class="tag-subtitle">{t.tag}</span>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-text">{t.desc1}</p>
      <p class="section-text highlight-text">{t.desc2}</p>
    </div>
    <div class="philosophy-image-col anim-slide-right">
      <!-- Imagen temporal (Unsplash, CC0). Reemplazar por imagen definitiva de marca. -->
      <img
        class="philosophy-image"
        src="https://images.unsplash.com/photo-1501139083538-0139583c060f?auto=format&fit=crop&w=1200&q=80"
        alt="Reloj de arena — tiempo y propósito"
        loading="lazy"
      />
    </div>
  </div>

  <div class="manifesto-banner anim-fade-up">
    <blockquote>{manifesto}</blockquote>
  </div>
</section>

<style>
  .about-philosophy {
    background-color: var(--color-white);
  }

  .philosophy-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 4rem;
    align-items: center;
  }

  .philosophy-text-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .philosophy-image-col {
    flex: 1;
    width: 100%;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-dark);
    line-height: 1.2;
  }

  .section-text {
    font-size: 1.125rem;
    color: var(--color-gray);
    line-height: 1.7;
  }

  .highlight-text {
    color: var(--color-primary);
    font-weight: 600;
  }

  .philosophy-image {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  .manifesto-banner {
    max-width: 1000px;
    margin: 6rem auto 0;
    text-align: center;
    padding: 4rem 2rem;
    background-color: var(--color-dark);
    border-radius: 20px;
  }

  .manifesto-banner blockquote {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--color-white);
    line-height: 1.4;
    font-weight: 500;
    font-style: italic;
  }

  @media (max-width: 900px) {
    .philosophy-container {
      flex-direction: column;
    }
    .manifesto-banner {
      margin-top: 4rem;
    }
  }
</style>
