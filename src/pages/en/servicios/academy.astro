---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Button from '../../../components/ui/Button.astro';
---

<Layout title="KAIROS Academy | Tailored workshops and training" description="Tailored training for companies, universities and schools: workshops, training programs and masterclasses in leadership, positioning, AI and strategy.">
  <Header />
  <main class="academy-page">
    <section class="academy-hero section-padding"><div class="academy-wrap academy-hero-grid"><div><span class="academy-kicker anim-fade-up">KAIROS ACADEMY · KNOWLEDGE · CAPABILITIES</span><h1 class="academy-hero-title anim-fade-up anim-delay-1">Knowledge that is not applied is forgotten.</h1><p class="academy-hero-copy anim-fade-up anim-delay-2">We design tailored workshops, training programs and masterclasses around the real opportunities we find inside your organization.</p><div class="academy-actions anim-fade-up anim-delay-3"><Button href="https://api.whatsapp.com/send?phone=573133024941&text=Hi%20Kairos%2C%20I%20want%20to%20learn%20about%20Kairos%20Academy%20for%20my%20organization." external variant="primary">Design your Academy plan</Button><a class="academy-link" href="#experience"><span>↓</span> See where we have taught</a></div></div><div class="academy-hero-card anim-fade-in anim-delay-2" aria-label="Kairos Academy: learn, apply, build and measure"><div class="academy-card-top"><span>ACADEMY / KAIROS</span><span class="academy-live"><i></i> IN ACTION</span></div><div class="academy-card-center"><strong class="academy-step is-active">LEARN</strong><span>↓</span><strong class="academy-step">APPLY</strong><span>↓</span><strong class="academy-step">BUILD</strong><span>↓</span><strong class="academy-step">MEASURE</strong><div class="academy-card-progress" aria-hidden="true"><i></i></div></div><div class="academy-card-foot"><span>KNOWLEDGE THAT STAYS</span><b>100%</b></div></div></div></section>
    <section class="academy-when section-padding"><div class="academy-wrap"><div class="academy-section-head"><div><span class="academy-kicker">WHEN IT MAKES SENSE</span><h2>When your team has the tools, but not the confidence to use them.</h2></div><p>Training works when it responds to a concrete challenge and can be applied the next day.</p></div><div class="academy-signal-grid"><p>You adopted new tools and usage remains hesitant or uneven.</p><p>A knowledge gap is slowing down processes or results.</p><p>Your leaders and professionals need stronger digital reputation and presence.</p><p>You want training that is applied tomorrow, not another talk.</p></div></div></section>
    <section class="academy-formats section-padding"><div class="academy-wrap"><span class="academy-kicker">WHAT WE DO</span><div class="academy-section-head"><h2>Three formats. One intention: knowledge that stays.</h2><p>The content changes with your challenge, but learning is always connected to action.</p></div><div class="academy-format-grid"><article><span>01</span><h3>Masterclass</h3><p>A high-impact session to open a conversation and inspire larger groups.</p><small>Ideal for events, communities and auditoriums.</small></article><article><span>02</span><h3>Workshop</h3><p>Guided practice in small groups. Each participant leaves with something built.</p><small>Ideal for teams and departments.</small></article><article><span>03</span><h3>Training program</h3><p>A multi-session program with learning goals, follow-up and results measurement.</p><small>Ideal for change and capability-building processes.</small></article></div><div class="academy-topics"><h3>Knowledge areas</h3><div class="academy-topic-groups"><article><span class="academy-topic-index">01</span><span class="academy-topic-label">BUSINESS & MANAGEMENT</span><div><span>Entrepreneurship</span><span>Marketing</span><span>Digital business</span></div></article><article><span class="academy-topic-index">02</span><span class="academy-topic-label">TECHNOLOGY & DATA</span><div><span>Applied AI</span><span>Big Data and Analytics</span><span>Agile methods</span></div></article><article><span class="academy-topic-index">03</span><span class="academy-topic-label">PEOPLE & DEVELOPMENT</span><div><span>Digital reputation and LinkedIn</span><span>Leadership and performance</span></div></article></div></div></div></section>
    <section class="academy-experience section-padding" id="experience"><div class="academy-wrap"><span class="academy-kicker">KAIROS ACADEMY IN ACTION</span><h2>Training we have already delivered.</h2><div class="academy-experience-grid"><article><span>MASTERCLASS</span><h3>Professional Digital Reputation</h3><p>Practical strategies to connect on LinkedIn and make your knowledge visible.</p></article><article><span>MASTERCLASS</span><h3>Silver Economy: AI for people over 50</h3><p>Digital and AI skills for people 50+.</p></article><article><span>WORKSHOP</span><h3>Coaching for tests and performance</h3><p>Preparation, focus and tools for a concrete challenge.</p></article><article class="academy-next"><span>NEXT</span><h3>Your organization?</h3><p>We design training around what your team needs.</p><a href="#contact">Book the visit →</a></article></div></div></section>
    <section class="academy-method section-padding"><div class="academy-wrap"><div class="academy-section-head"><div><span class="academy-kicker">HOW IT WORKS</span><h2>First we understand your organization. Then we design what it needs to learn.</h2></div><p>We do not arrive with a catalog course. We listen to leaders and teams and build a tailored Academy plan.</p></div><div class="academy-process"><div><span>01 · WE VISIT</span><h3>On-site diagnosis</h3><p>Conversations with leaders, process observation and a short team survey.</p></div><div><span>02 · WE DETECT</span><h3>Opportunity map</h3><p>We identify what knowledge is missing, where it slows results and what will have the most impact.</p></div><div><span>03 · WE DESIGN</span><h3>Tailored Academy plan</h3><p>Formats, topics, groups, schedule and learning indicators.</p></div><div><span>04 · WE TEACH AND MEASURE</span><h3>Delivery and follow-up</h3><p>We deliver the sessions and measure what was applied and what changed.</p></div></div></div></section>
    <section class="academy-cta section-padding" id="contact"><div class="academy-wrap academy-cta-inner"><span class="academy-kicker">KAIROS ACADEMY</span><h2>What does your team need to learn to move forward?</h2><p>Book a visit and build your Academy plan with us.</p><div class="academy-cta-actions"><Button href="https://cal.com/kairos4us/30min" external variant="primary">Book the diagnostic visit</Button><a class="academy-whatsapp-link" href="https://api.whatsapp.com/send?phone=573133024941&text=Hi%20Kairos%2C%20I%20want%20to%20learn%20about%20Kairos%20Academy%20for%20my%20organization." target="_blank" rel="noopener noreferrer">Write us on WhatsApp</a></div></div></section>
  </main>
  <Footer />
</Layout>

<style>
  :global(.header){background:var(--color-white)}:global(.header .nav-links a){color:rgba(10,10,10,.72)}:global(.header .nav-links a:hover){color:var(--color-dark)}:global(.header .lang-text){color:rgba(10,10,10,.48)!important}:global(.header .lang-divider){color:rgba(10,10,10,.2)!important}:global(.header .menu-toggle span){background-color:rgba(10,10,10,.7)}
  .academy-page{background:var(--color-white);color:var(--color-dark)}.academy-wrap{max-width:1120px;margin:0 auto;padding:0 1.5rem}.academy-kicker{display:block;color:var(--color-primary);font-family:var(--font-heading);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:1.3rem}.academy-hero{min-height:78vh;display:flex;align-items:center}.academy-hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.academy-hero-title,.academy-section-head h2,.academy-formats h2,.academy-experience h2,.academy-cta h2{font-family:'Bricolage Grotesque',var(--font-heading),system-ui,sans-serif;font-weight:800;letter-spacing:-.04em;line-height:1}.academy-hero-title{max-width:10ch;font-size:clamp(3rem,6vw,5.2rem)}.academy-hero-copy{max-width:48ch;color:var(--color-gray);font-size:1.08rem;line-height:1.65;margin:1.8rem 0 2.2rem}.academy-actions{display:flex;gap:1.4rem;align-items:center;flex-wrap:wrap}.academy-link{color:var(--color-gray);font-size:.9rem}.academy-link span{color:var(--color-primary);font-size:1.2rem;margin-right:.4rem}.academy-hero-card{min-height:470px;padding:1.3rem;background:#0a0a0a;color:#fff;border-radius:4px;box-shadow:0 24px 60px rgba(10,10,10,.16);display:flex;flex-direction:column}.academy-card-top,.academy-card-foot{display:flex;justify-content:space-between;font-family:var(--font-heading);font-size:.62rem;letter-spacing:.13em;color:#999}.academy-live{color:var(--color-primary)}.academy-live i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--color-primary);margin-right:.4rem;animation:academyPulse 1.8s ease-in-out infinite}.academy-card-center{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:.7rem;font-family:var(--font-heading);font-size:clamp(1.5rem,3vw,2.5rem);letter-spacing:-.04em}.academy-card-center strong{opacity:.38;animation:academyStep 8s ease-in-out infinite}.academy-card-center strong:nth-of-type(2){animation-delay:-2s}.academy-card-center strong:nth-of-type(3){animation-delay:-4s}.academy-card-center strong:nth-of-type(4){animation-delay:-6s}.academy-card-center span{color:#666;font-size:1.3rem;animation:academyArrow 8s ease-in-out infinite}.academy-card-center span:nth-of-type(2){animation-delay:-2s}.academy-card-center span:nth-of-type(3){animation-delay:-4s}.academy-card-center span:nth-of-type(4){animation-delay:-6s}.academy-card-progress{width:min(13rem,70%);height:2px;margin-top:.7rem;background:rgba(255,255,255,.16);overflow:hidden}.academy-card-progress i{display:block;width:25%;height:100%;background:var(--color-primary);transform-origin:left;animation:academyProgress 8s linear infinite}.academy-card-foot{padding-top:1rem;border-top:1px solid rgba(255,255,255,.18)}.academy-card-foot b{color:var(--color-primary);font-size:1rem}.academy-when,.academy-method{background:#0a0a0a;color:#fff}.academy-section-head{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:end}.academy-section-head h2,.academy-formats h2,.academy-experience h2{max-width:18ch;font-size:clamp(2rem,4vw,3.4rem)}.academy-section-head>p,.academy-format-grid p,.academy-experience p,.academy-process p{color:#999;line-height:1.65}.academy-signal-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0 4rem;margin-top:4rem;border-top:1px solid rgba(255,255,255,.16)}.academy-signal-grid p{padding:1.3rem 0;border-bottom:1px solid rgba(255,255,255,.16);color:#bbb;line-height:1.5}.academy-formats{background:#fafafa}.academy-formats h2{color:var(--color-dark)}.academy-formats .academy-section-head{margin-bottom:3.3rem}.academy-format-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #e3e3e3}.academy-format-grid article{padding:2rem 2rem 2rem 0;border-right:1px solid #e3e3e3}.academy-format-grid article+article{padding-left:2rem}.academy-format-grid article:last-child{border-right:0}.academy-format-grid span,.academy-experience article>span,.academy-process>div>span{color:var(--color-primary);font-family:var(--font-heading);font-size:.7rem;letter-spacing:.14em}.academy-format-grid h3,.academy-experience h3,.academy-process h3{font-size:1.35rem;margin:.9rem 0 .5rem}.academy-format-grid small{color:#777;line-height:1.5}.academy-topics{margin-top:4rem;padding-top:2rem;border-top:1px solid #e3e3e3}.academy-topics h3{font-size:1.1rem;margin-bottom:1.2rem}.academy-topics div{display:flex;flex-wrap:wrap;gap:.6rem}.academy-topics span{padding:.65rem .85rem;border:1px solid #ddd;border-radius:999px;color:#555;font-size:.82rem}.academy-experience{background:#fff}.academy-experience h2{margin-bottom:3rem}.academy-experience-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #e3e3e3}.academy-experience article{padding:1.5rem 1.2rem 0 0;border-right:1px solid #e3e3e3}.academy-experience article+article{padding-left:1.2rem}.academy-experience article:last-child{border:0}.academy-experience h3{font-size:1.1rem}.academy-next{background:#fff1eb}.academy-next a{color:var(--color-primary);font-family:var(--font-heading);font-size:.85rem;font-weight:700}.academy-method{border-top:1px solid rgba(255,255,255,.08)}.academy-process{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-top:3.5rem;border-top:1px solid rgba(255,255,255,.25)}.academy-process>div{padding-top:1.6rem}.academy-process h3{color:#fff;font-size:1.15rem}.academy-cta{text-align:center;background:#fafafa}.academy-cta-inner{display:flex;align-items:center;flex-direction:column}.academy-cta h2{max-width:16ch;font-size:clamp(2.3rem,5vw,4rem)}.academy-cta p{color:var(--color-gray);margin:1.5rem 0 2rem}@keyframes academyPulse{50%{opacity:.35;transform:scale(.7)}}@keyframes academyStep{0%,20%{opacity:1;color:var(--color-primary);transform:scale(1.08)}20.01%,100%{opacity:.38;color:#fff;transform:scale(1)}}@keyframes academyArrow{0%,20%{color:var(--color-primary);opacity:1}20.01%,100%{color:#666;opacity:.45}}@keyframes academyProgress{0%{transform:translateX(-100%)}100%{transform:translateX(400%)}}
  @media (prefers-reduced-motion:reduce){.academy-card-center strong,.academy-card-center span,.academy-card-progress i,.academy-live i{animation:none}.academy-card-center strong:first-child{opacity:1;color:var(--color-primary);transform:scale(1.08)}}
  @media(max-width:860px){.academy-hero-grid,.academy-section-head{grid-template-columns:1fr;gap:2.2rem}.academy-hero{min-height:auto}.academy-hero-card{min-height:380px}.academy-format-grid{grid-template-columns:1fr}.academy-format-grid article,.academy-format-grid article+article{padding:1.5rem 0;border-right:0;border-bottom:1px solid #e3e3e3}.academy-experience-grid{grid-template-columns:repeat(2,1fr)}.academy-experience article:nth-child(2){border-right:0}.academy-experience article:nth-child(3){padding-left:0}.academy-process{grid-template-columns:repeat(2,1fr);row-gap:2.5rem}}
  @media(max-width:580px){.academy-wrap{padding:0 1.25rem}.academy-hero-title{font-size:clamp(2.8rem,14vw,4rem)}.academy-actions{align-items:flex-start;flex-direction:column}.academy-signal-grid,.academy-experience-grid,.academy-process{grid-template-columns:1fr}.academy-experience article,.academy-experience article+article{padding:1.4rem 0;border-right:0;border-bottom:1px solid #e3e3e3}.academy-experience article:last-child{border-bottom:0}.academy-card-center{font-size:1.8rem}}</style>
<style>
  .academy-card-center .academy-step{animation:none;opacity:.38;color:#fff;transform:scale(1);transition:color .35s ease,opacity .35s ease,transform .35s ease}
  .academy-card-center .academy-step.is-active{opacity:1;color:var(--color-primary);transform:scale(1.08)}
  .academy-card-center strong:nth-of-type(2), .academy-card-center span:nth-of-type(2){animation-delay:2s}
  .academy-card-center strong:nth-of-type(3), .academy-card-center span:nth-of-type(3){animation-delay:4s}
  .academy-card-center strong:nth-of-type(4), .academy-card-center span:nth-of-type(4){animation-delay:6s}
  .academy-topic-groups{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1.5rem}
  .academy-topic-groups article{padding:1.2rem;border:1px solid #e1e1e1;background:#fff;transition:border-color .25s ease,transform .25s ease}
  .academy-topic-groups article:hover{border-color:var(--color-primary);transform:translateY(-3px)}
  .academy-topic-groups .academy-topic-label{display:block;margin-bottom:.9rem;color:var(--color-primary);font-family:var(--font-heading);font-size:.65rem;letter-spacing:.14em;font-weight:700}
  .academy-topic-groups article>div{display:flex;flex-wrap:wrap;gap:.45rem}
  .academy-topic-groups article>div span{padding:0;border:0;color:#555;font-size:.8rem;line-height:1.35}
  .academy-topic-groups article>div span+span:before{content:'·';margin:0 .45rem;color:var(--color-primary)}
  /* Knowledge areas: aligned editorial index instead of a wrapping chip cloud. */
  .academy-topics{display:grid;grid-template-columns:minmax(10rem,.65fr) minmax(0,2fr);gap:3rem;align-items:start}
  .academy-topics h3{margin:0;max-width:9ch;font-family:'Bricolage Grotesque',var(--font-heading),system-ui,sans-serif;font-size:clamp(1.55rem,3vw,2.15rem);line-height:1;letter-spacing:-.04em}
  .academy-topics .academy-topic-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin-top:0;border-top:1px solid #dedede;border-bottom:1px solid #dedede}
  .academy-topics .academy-topic-groups article{min-width:0;padding:1.2rem 1.15rem 1.45rem 0;border:0;border-right:1px solid #dedede;background:transparent;transform:none}
  .academy-topics .academy-topic-groups article+article{padding-left:1.15rem}
  .academy-topics .academy-topic-groups article:last-child{border-right:0;padding-right:0}
  .academy-topic-index{display:block!important;padding:0!important;border:0!important;color:var(--color-primary)!important;font-family:var(--font-heading);font-size:.72rem!important;letter-spacing:.12em;font-weight:700}
  .academy-topics .academy-topic-groups .academy-topic-label{display:block;margin:.85rem 0 1rem;color:var(--color-dark);font-size:.63rem;line-height:1.35;letter-spacing:.12em}
  .academy-topics .academy-topic-groups article>div{display:grid;gap:.55rem}
  .academy-topics .academy-topic-groups article>div span{position:relative;padding:0 0 0 .85rem;border:0;color:#666;font-size:.8rem;line-height:1.35}
  .academy-topics .academy-topic-groups article>div span:before{content:'';position:absolute;left:0;top:.48em;width:4px;height:4px;border-radius:50%;background:var(--color-primary)}
  .academy-topics .academy-topic-groups article>div span+span:before{content:'';margin:0}
  @media(max-width:860px){.academy-topics{grid-template-columns:1fr;gap:1.5rem}.academy-topics h3{max-width:none}.academy-topics .academy-topic-groups{grid-template-columns:1fr}.academy-topics .academy-topic-groups article,.academy-topics .academy-topic-groups article+article,.academy-topics .academy-topic-groups article:last-child{padding:1.15rem 0;border-right:0;border-bottom:1px solid #dedede}.academy-topics .academy-topic-groups article:last-child{border-bottom:0}}
</style>

<style>
  .academy-cta-actions > a.btn-primary { color: #fff; }
  .academy-cta-actions > a.btn-primary:hover,
  .academy-cta-actions > a.btn-primary:focus-visible { color: var(--color-primary); }
  .academy-cta-actions .academy-whatsapp-link { color: var(--color-primary); }
</style>

<script>
  const academySteps = [...document.querySelectorAll<HTMLElement>('.academy-step')];
  const academyReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let academyActiveStep = 0;

  const setAcademyStep = (index: number) => {
    academySteps.forEach((step, stepIndex) => step.classList.toggle('is-active', stepIndex === index));
  };

  setAcademyStep(academyActiveStep);
  if (!academyReducedMotion) {
    window.setInterval(() => {
      academyActiveStep = (academyActiveStep + 1) % academySteps.length;
      setAcademyStep(academyActiveStep);
    }, 2000);
  }
</script>
