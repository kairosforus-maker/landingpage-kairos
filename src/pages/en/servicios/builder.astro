---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Button from '../../../components/ui/Button.astro';
---

<Layout title="KAIROS Builder | Business building and strategy" description="KAIROS helps businesses and organizations turn business challenges into solutions through strategy, training, execution, and capabilities.">
  <Header />
  <main>
    <section class="builder-hero section-padding"><div class="builder-wrap builder-hero-grid"><div class="builder-hero-copy"><span class="builder-eyebrow anim-fade-up">BUSINESS BUILDING · STRATEGY · EXECUTION</span><h1 class="builder-hero-title anim-fade-up anim-delay-1">Your business challenge needs more than a recommendation.</h1><p class="builder-hero-desc anim-fade-up anim-delay-2">Kairos guides the entire process: understanding the challenge, designing the direction, building the solution, and measuring its impact. Strategy, coaching, and execution in one team.</p><div class="builder-actions anim-fade-up anim-delay-3"><Button href="https://api.whatsapp.com/send?phone=573133024941&amp;text=Hi%20Kairos%2C%20I%20want%20to%20design%20a%20B2B%20project." external variant="primary">Let's design the project</Button><a class="builder-text-link" href="#process"><span>↓</span> See how we work</a></div></div><div class="builder-blueprint anim-fade-in anim-delay-2" aria-label="A project's construction journey"><div class="blueprint-top"><span>PROJECT / KAIROS</span><span class="blueprint-live"><i></i> IN CONSTRUCTION</span></div><div class="blueprint-stages"><div class="blueprint-line"></div><div class="blueprint-stage is-start" style="--stage-delay:0s"><b>01</b><span>Understand</span><small>Context and root cause</small></div><div class="blueprint-stage" style="--stage-delay:-6s"><b>02</b><span>Design</span><small>Direction and strategy</small></div><div class="blueprint-stage" style="--stage-delay:-4s"><b>03</b><span>Build</span><small>Team and execution</small></div><div class="blueprint-stage" style="--stage-delay:-2s"><b>04</b><span>Measure</span><small>Indicators and transfer</small></div></div><div class="blueprint-foot"><span>CAPABILITY THAT STAYS</span><strong>100%</strong></div></div></div></section>

    <section class="builder-signals section-padding"><div class="builder-wrap"><div class="builder-section-intro"><div><span class="builder-kicker anim-fade-up">WHEN IT MAKES SENSE</span><h2 class="builder-title builder-title-dark anim-fade-up anim-delay-1">When the challenge can no longer be solved with an outside opinion.</h2></div><p class="builder-intro builder-intro-dark anim-fade-up anim-delay-2">We enter when clarity, structure, or capability is missing and the whole challenge needs to become a shared direction.</p></div><div class="signal-list anim-fade-up anim-delay-3"><div class="signal-item"><span>01</span><p>You know there is a problem, but you have not found the cause.</p></div><div class="signal-item"><span>02</span><p>You have a strategy, but lack the structure to execute it.</p></div><div class="signal-item"><span>03</span><p>You need capabilities that do not exist inside the team today.</p></div><div class="signal-item"><span>04</span><p>There is a concrete project that needs to go from start to finish.</p></div><div class="signal-item"><span>05</span><p>You need a temporary team to integrate and make it real.</p></div></div></div></section>

    <section class="builder-areas section-padding"><div class="builder-wrap"><span class="builder-kicker anim-fade-up">WHAT WE BUILD</span><div class="builder-areas-head"><h2 class="builder-title builder-title-dark anim-fade-up anim-delay-1">We build what your organization needs to move forward.</h2><p class="builder-intro builder-intro-dark anim-fade-up anim-delay-2">We build solutions by connecting strategy, people, and operations so an organization can move forward with direction.</p></div><div class="area-list anim-fade-up anim-delay-3"><div class="area-row"><span>01</span><h3>Identity and direction</h3><p>We define what the organization is, what it represents, and where it can go next.</p><b>↗</b></div><div class="area-row"><span>02</span><h3>Reputation and presence</h3><p>We turn that direction into a clear and coherent presence for the market.</p><b>↗</b></div><div class="area-row"><span>03</span><h3>Leadership and capabilities</h3><p>We strengthen the capabilities needed to decide, execute, and sustain progress.</p><b>↗</b></div><div class="area-row"><span>04</span><h3>Experience and operations</h3><p>We make the strategy consistent at every point where the organization acts.</p><b>↗</b></div></div></div></section>

    <section class="builder-process section-padding" id="process"><div class="builder-wrap"><div class="builder-process-head"><div><span class="builder-kicker anim-fade-up">HOW WE WORK</span><h2 class="builder-title anim-fade-up anim-delay-1">From diagnosis to a solution that lasts.</h2></div><p class="builder-intro anim-fade-up anim-delay-2">We do not deliver recommendations and disappear. We build with you until the solution can sustain itself.</p></div><div class="builder-timeline anim-fade-up anim-delay-3"><div class="timeline-step"><span>01</span><div><h3>Diagnosis</h3><p>We understand the context, the cause, and what the organization needs to build.</p></div></div><div class="timeline-step"><span>02</span><div><h3>Strategy</h3><p>We turn that understanding into direction, priorities, and a shared route.</p></div></div><div class="timeline-step"><span>03</span><div><h3>Support and capabilities</h3><p>We support the team and add the capabilities the project requires.</p></div></div><div class="timeline-step"><span>04</span><div><h3>Execution and indicators</h3><p>We build, measure, and transfer what we learn so progress continues.</p></div></div></div></div></section>

    <section class="builder-cta section-padding" id="project"><div class="builder-wrap builder-cta-inner anim-fade-up"><span class="builder-kicker">B2B PROJECTS</span><h2 class="builder-cta-title">Every challenge requires a different build.</h2><p class="builder-cta-desc">Each project is built according to scope, duration, team, resources, objectives, and indicators.</p><Button href="https://api.whatsapp.com/send?phone=573133024941&amp;text=Hi%20Kairos%2C%20I%20want%20to%20design%20a%20B2B%20project." external variant="primary">Let's design the project</Button></div></section>
  </main>
  <Footer />
</Layout>

<style>
  :global(.header){background-color:var(--color-white)}:global(.header .nav-links a){color:rgba(10,10,10,.72)}:global(.header .nav-links a:hover){color:var(--color-dark)}:global(.header .lang-text){color:rgba(10,10,10,.48)!important}:global(.header .lang-divider){color:rgba(10,10,10,.2)!important}:global(.header .menu-toggle span){background-color:rgba(10,10,10,.7)}
  .builder-wrap{max-width:1120px;margin:0 auto;padding:0 1.5rem}.builder-eyebrow,.builder-kicker{display:block;color:var(--color-primary);font-family:var(--font-heading);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:1.35rem}.builder-title{max-width:19ch;color:var(--color-white);font-family:'Bricolage Grotesque',var(--font-heading),system-ui,sans-serif;font-size:clamp(2rem,4.2vw,3.25rem);font-weight:800;line-height:1.02;letter-spacing:-.03em}.builder-title-dark{color:var(--color-dark)}.builder-intro{max-width:43ch;color:#999;font-size:1.05rem;line-height:1.65}.builder-intro-dark{color:var(--color-gray)}
  .builder-hero{background:var(--color-white);min-height:78vh;display:flex;align-items:center;overflow:hidden}.builder-hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:5rem;align-items:center}.builder-hero-title{max-width:12ch;color:var(--color-dark);font-family:'Bricolage Grotesque',var(--font-heading),system-ui,sans-serif;font-size:clamp(2.8rem,6vw,5rem);font-weight:800;line-height:.98;letter-spacing:-.045em}.builder-hero-desc{max-width:50ch;color:var(--color-gray);font-size:1.1rem;line-height:1.65;margin:1.75rem 0 2.25rem}.builder-actions{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}.builder-text-link{color:var(--color-gray);font-size:.9rem;transition:color .25s ease}.builder-text-link span{color:var(--color-primary);margin-right:.45rem;font-size:1.15rem}.builder-text-link:hover{color:var(--color-dark)}
  .builder-blueprint{position:relative;min-height:480px;padding:1.25rem;background:var(--color-light);border:1px solid rgba(10,10,10,.14);border-radius:4px;box-shadow:0 24px 60px rgba(10,10,10,.12)}.blueprint-top,.blueprint-foot{display:flex;justify-content:space-between;color:rgba(10,10,10,.55);font-family:var(--font-heading);font-size:.62rem;letter-spacing:.12em}.blueprint-live{color:var(--color-primary)}.blueprint-live i{display:inline-block;width:6px;height:6px;margin-right:5px;border-radius:50%;background:var(--color-primary);animation:builderPulse 1.8s ease-in-out infinite}.blueprint-stages{position:relative;display:grid;gap:1.15rem;margin-top:2.3rem;padding-bottom:3.5rem}.blueprint-line{position:absolute;top:22px;bottom:22px;left:22px;width:1px;background:linear-gradient(to bottom,var(--color-primary),rgba(255,77,0,.2))}.blueprint-stage{position:relative;display:grid;grid-template-columns:44px 1fr;gap:.25rem 1rem;align-items:center;margin:0}.blueprint-stage b{z-index:1;display:grid;place-items:center;width:44px;height:44px;border:1px solid rgba(10,10,10,.22);border-radius:50%;background:var(--color-light);color:rgba(10,10,10,.45);font-family:var(--font-heading);font-size:.8rem;animation:builderFocusCircle 8s linear infinite;animation-delay:var(--stage-delay)}.blueprint-stage span{color:var(--color-dark);font-family:var(--font-heading);font-size:1.15rem;font-weight:700;animation:builderFocusTitle 8s linear infinite;animation-delay:var(--stage-delay)}.blueprint-stage small{grid-column:2;color:rgba(10,10,10,.55);font-size:.8rem;animation:builderFocusDetail 8s linear infinite;animation-delay:var(--stage-delay)}.blueprint-foot{position:absolute;right:1.25rem;bottom:1.25rem;left:1.25rem;padding-top:1rem;border-top:1px solid rgba(10,10,10,.14)}.blueprint-foot strong{color:var(--color-primary);font-size:1rem}@keyframes builderPulse{50%{opacity:.35;transform:scale(.7)}}@keyframes builderFocusCircle{0%,24.99%{border-color:var(--color-primary);background:var(--color-primary);color:var(--color-dark);box-shadow:0 0 0 8px rgba(255,77,0,.14);transform:scale(1.03)}25%,100%{border-color:rgba(10,10,10,.22);background:var(--color-light);color:rgba(10,10,10,.45);box-shadow:none;transform:scale(1)}}@keyframes builderFocusTitle{0%,24.99%{color:var(--color-primary)}25%,100%{color:var(--color-dark)}}@keyframes builderFocusDetail{0%,24.99%{color:rgba(10,10,10,.68)}25%,100%{color:rgba(10,10,10,.55)}}
  .builder-signals{background:var(--color-dark);border-bottom:1px solid rgba(255,255,255,.08)}.builder-signals .builder-title-dark{color:var(--color-white)}.builder-signals .builder-intro-dark{color:#999}.builder-section-intro{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:end}.builder-section-intro .builder-intro{margin-bottom:.3rem}.signal-list{margin-top:4rem;display:grid;grid-template-columns:repeat(2,1fr);column-gap:4rem;border-top:1px solid rgba(255,255,255,.14)}.signal-item{display:grid;grid-template-columns:42px 1fr;gap:1.25rem;padding:1.25rem 0;border-bottom:1px solid rgba(255,255,255,.14)}.signal-item span{color:var(--color-primary);font-family:var(--font-heading);font-size:.72rem;letter-spacing:.1em}.signal-item p{color:#aaa;line-height:1.5}
  .builder-system{background:var(--color-white);border-bottom:1px solid var(--color-gray-light)}.builder-system .builder-title{color:var(--color-dark)}.builder-system .builder-intro{color:var(--color-gray)}.builder-system-head,.builder-process-head{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:end}.builder-system-head .builder-intro,.builder-process-head .builder-intro{margin-bottom:.25rem}.sphere-map{position:relative;min-height:500px;margin-top:3rem;border:1px solid rgba(255,255,255,.12);background:radial-gradient(circle at center,rgba(255,77,0,.1),transparent 30%),#111;overflow:hidden}.sphere-map:before,.sphere-map:after{content:'';position:absolute;inset:18% 28%;border:1px solid rgba(255,255,255,.08);border-radius:50%}.sphere-map:after{inset:30% 38%;border-color:rgba(255,77,0,.25)}.sphere-center{position:absolute;top:50%;left:50%;z-index:2;display:grid;place-items:center;width:128px;height:128px;transform:translate(-50%,-50%);border-radius:50%;background:var(--color-primary);color:var(--color-dark);font-family:var(--font-heading);font-size:.78rem;font-weight:800;letter-spacing:.1em}.sphere-center small{font-size:.62rem;font-weight:400;letter-spacing:0}.sphere-node{position:absolute;z-index:2;display:flex;align-items:center;gap:.6rem;color:#ddd;font-family:var(--font-heading);font-size:.9rem}.sphere-node b{color:var(--color-primary);font-size:.65rem}.node-1{top:18%;left:12%}.node-2{top:11%;left:47%}.node-3{top:19%;right:11%}.node-4{top:48%;left:5%}.node-5{top:48%;right:5%}.node-6{bottom:17%;left:22%}.node-7{right:19%;bottom:17%}
  .builder-areas{background:var(--color-white);border-bottom:1px solid var(--color-gray-light)}.builder-areas .builder-title-dark{color:var(--color-dark)}.builder-areas .builder-intro-dark{color:var(--color-gray)}.builder-areas-head{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:end}.area-list{margin-top:3.5rem;border-top:1px solid var(--color-gray-light)}.area-row{display:grid;grid-template-columns:52px 1.2fr 1fr 30px;gap:1rem;align-items:center;padding:1.3rem 0;border-bottom:1px solid var(--color-gray-light)}.area-row>span{color:var(--color-primary);font-family:var(--font-heading);font-size:.72rem}.area-row h3{color:var(--color-dark);font-size:1.35rem}.area-row p{color:var(--color-gray);font-size:.9rem}.area-row b{color:var(--color-primary);font-size:1.15rem;text-align:right}
  .builder-process{background:var(--color-dark);border-bottom:1px solid rgba(255,255,255,.08)}.builder-process .builder-title{color:var(--color-white)}.builder-process .builder-intro{color:#999}.builder-timeline{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-top:3.5rem;border-top:1px solid rgba(255,255,255,.28)}.timeline-step{position:relative;padding-top:2rem}.timeline-step:before{content:'';position:absolute;top:-5px;left:0;width:9px;height:9px;border-radius:50%;background:var(--color-primary);box-shadow:0 0 0 6px var(--color-dark)}.timeline-step>span{color:var(--color-primary);font-family:var(--font-heading);font-size:.75rem;letter-spacing:.12em}.timeline-step h3{margin:1rem 0 .55rem;color:var(--color-white);font-size:1.2rem}.timeline-step p{max-width:23ch;color:#888;font-size:.9rem;line-height:1.55}
  .builder-cta{background:var(--color-white);text-align:center}.builder-cta-title{max-width:16ch;color:var(--color-dark);font-family:'Bricolage Grotesque',var(--font-heading),system-ui,sans-serif;font-size:clamp(2rem,4.5vw,3.5rem);font-weight:800;line-height:1;letter-spacing:-.035em}.builder-cta-inner{display:flex;flex-direction:column;align-items:center}.builder-cta-desc{max-width:48ch;margin:1.5rem 0 2rem;color:var(--color-gray);font-size:1.05rem;line-height:1.6}
  @media(max-width:860px){.builder-hero-grid,.builder-section-intro,.builder-system-head,.builder-process-head,.builder-areas-head{grid-template-columns:1fr;gap:2rem}.builder-hero{min-height:auto}.builder-blueprint{min-height:380px}.signal-list{column-gap:2rem}.sphere-map{min-height:430px}.builder-timeline{grid-template-columns:repeat(2,1fr);row-gap:2.5rem}.timeline-step:nth-child(3):after{content:'';position:absolute;top:-1.5rem;left:0;right:-100%;height:1px;background:rgba(255,255,255,.18)}}
  @media(max-width:580px){.builder-wrap{padding:0 1.25rem}.builder-hero-title{font-size:clamp(2.65rem,13vw,4rem)}.builder-actions{align-items:flex-start;flex-direction:column;gap:1rem}.signal-list{grid-template-columns:1fr;margin-top:2.5rem}.builder-blueprint{min-height:470px}.sphere-map{min-height:490px}.sphere-map:before{inset:18% 9%}.sphere-map:after{inset:30% 20%}.sphere-node{font-size:.78rem}.node-1{top:12%;left:7%}.node-2{top:8%;left:38%}.node-3{top:17%;right:7%}.node-4{top:47%;left:4%}.node-5{top:47%;right:4%}.node-6{bottom:15%;left:9%}.node-7{right:8%;bottom:15%}.area-row{grid-template-columns:36px 1fr 22px}.area-row p{display:none}.builder-timeline{grid-template-columns:1fr;gap:2rem}.timeline-step:nth-child(3):after{display:none}}
  @media(prefers-reduced-motion:reduce){.blueprint-stage b,.blueprint-stage span,.blueprint-stage small,.blueprint-live i{animation:none}.blueprint-stage.is-start b{border-color:var(--color-primary);background:var(--color-primary);color:var(--color-dark);box-shadow:0 0 0 8px rgba(255,77,0,.14)}.blueprint-stage.is-start span{color:var(--color-primary)}.blueprint-stage.is-start small{color:rgba(10,10,10,.68)}}
</style>
