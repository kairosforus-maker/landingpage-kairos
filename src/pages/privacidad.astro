		background-color: var(--color-light);
		min-height: 60vh;
	}
	.legal-inner {
		max-width: 780px;
		margin: 0 auto;
	}
	.legal-inner h1 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		color: var(--color-dark);
		margin-bottom: 0.5rem;
	}
	.legal-meta {
		color: var(--color-gray);
		font-size: 0.9rem;
		margin-bottom: 2rem;
		opacity: 0.7;
	}
	.legal-inner h2 {
		font-size: 1.35rem;
		color: var(--color-dark);
		margin: 2.5rem 0 0.75rem;
	}
	.legal-inner p {
		color: var(--color-gray);
		line-height: 1.7;
		margin-bottom: 0.75rem;
	}
	.legal-inner ul,
	.legal-inner ol {
		color: var(--color-gray);
		line-height: 1.7;
		margin-bottom: 1rem;
		padding-left: 1.5rem;
	}
	.legal-inner li {
		margin-bottom: 0.4rem;
	}
	.legal-inner strong {
		color: var(--color-dark);
	}
</style>
