---
import Button from '../ui/Button.astro';
import { getLangFromUrl, content } from '../../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = content[lang].cta;
---

<section id="contacto" class="cta section-padding">
  <div class="cta-content anim-fade-up">
    <span class="tag-subtitle">{t.tag}</span>
    <h2 class="section-title">{t.title}</h2>
    <p class="section-text">{t.desc}</p>

    <div class="cta-actions">
      <!-- Primer botón naranja primary -->
      <Button href="https://cal.com/kairos4us/30min" onclick="event.preventDefault();" data-cal-link="kairos4us/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' variant="primary">
        {t.btnTalk}
      </Button>
    </div>

    <div class="cta-methods">
      <span class="cta-methods-title">{t.methodsTitle}</span>
      <div class="cta-methods-list">
        {t.methods.map((m) => (
          <a
            class="cta-method"
            href={m.href}
            target={m.type === 'email' ? '_self' : '_blank'}
            rel="noopener noreferrer"
          >
            <span class="cta-method-label">{m.label}</span>
            <span class="cta-method-value">{m.value}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background-color: var(--color-white);
    display: flex;
    justify-content: center;
    border-top: 1px solid #1a1a1a;
  }

  .cta-content {
    text-align: center;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .section-title {
    font-size: clamp(2.18rem, 4vw, 3rem);
    margin-bottom: 0.5rem;
    color: var(--color-dark);
  }

  .section-text {
    font-size: clamp(1.06rem, 2vw, 1.25rem);
    color: var(--color-gray);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .cta-actions {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .cta-methods {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .cta-methods-title {
    font-size: 0.9rem;
    color: #6b6b6b;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: var(--font-heading);
  }

  .cta-methods-list {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-method {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    background-color: var(--color-light);
    border: 1px solid var(--color-gray-light);
    border-radius: 14px;
    padding: 0.9rem 1.4rem;
    transition: border-color 0.3s ease, transform 0.3s ease;
    text-align: left;
  }

  .cta-method:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .cta-method-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cta-method-value {
    color: var(--color-dark);
    font-size: 1rem;
  }

</style>
