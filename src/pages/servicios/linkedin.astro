---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Button from '../../components/ui/Button.astro';
---

<Layout
  title="KAIROS LinkedIn | Posicionamiento profesional"
  description="Construimos una presencia en LinkedIn alineada con tu identidad, experiencia y dirección profesional."
  schemaType="Service"
>
  <Header />
  <main>

    <!-- HERO -->
    <section class="ln-hero section-padding">
      <div class="ln-wrap ln-hero-grid">
        <div class="ln-hero-text anim-fade-up">
          <span class="ln-eyebrow">KAIROS LINKEDIN · IDENTIDAD Y POSICIONAMIENTO</span>
          <h1>Tu conocimiento tiene valor. Pero si nadie entiende quién eres, nadie sabrá por qué <span class="ln-highlight">escucharte</span>.</h1>
          <p class="ln-lede">Construimos una presencia en LinkedIn alineada con tu identidad, experiencia y dirección profesional.</p>
        </div>

        <div class="search-mock anim-fade-up anim-delay-2" aria-label="Ejemplo de búsqueda de un reclutador">
          <div class="search-bar">
            <span class="search-dot"></span>
            <span class="search-query">analista marketing AND "aerolíneas" AND Madrid<span class="search-caret"></span></span>
          </div>
          <div class="search-filters">
            <span class="search-chip">Sector: Aviación</span>
            <span class="search-chip">Idioma: ES · EN</span>
            <span class="search-chip">Exp: 1-3 años</span>
          </div>
          <div class="search-results">
            <div class="search-res ghost"><span class="res-av"></span><span class="res-lines"><span class="res-ln a"></span><span class="res-ln b"></span></span></div>
            <div class="search-res ghost"><span class="res-av"></span><span class="res-lines"><span class="res-ln a"></span><span class="res-ln b"></span></span></div>
            <div class="search-res hit">
              <span class="res-av hit-av"></span>
              <span class="res-info">
                <span class="res-name">Fernando Barrera</span>
                <span class="res-role">Marketing · Análisis del sector aéreo</span>
              </span>
              <span class="res-tag">Coincide</span>
            </div>
            <div class="search-res ghost"><span class="res-av"></span><span class="res-lines"><span class="res-ln a"></span><span class="res-ln b"></span></span></div>
          </div>
          <div class="search-foot">Un perfil sin palabras clave no está mal escrito. Simplemente no está en la lista.</div>
        </div>
      </div>
    </section>

    <!-- WHAT WE DO -->
    <section class="ln-offer section-padding">
      <div class="ln-wrap">
        <span class="ln-kicker anim-fade-up">QUÉ HACEMOS</span>
        <h2 class="ln-section-title ln-section-title-dark anim-fade-up anim-delay-1">Convertimos lo que sabes en una presencia que representa quién eres.</h2>
        <p class="ln-intro ln-intro-dark anim-fade-up anim-delay-2">No se trata de publicar más. Se trata de construir una identidad profesional clara, reconocible y alineada con la dirección que quieres tomar.</p>
        <div class="ln-offer-grid anim-fade-up anim-delay-3">
          <div class="ln-offer-item"><span class="ln-offer-number">01</span><h3>Perfil</h3><p>Construimos una base clara: quién eres, qué representas y cómo quieres ser percibido.</p></div>
          <div class="ln-offer-item"><span class="ln-offer-number">02</span><h3>Red</h3><p>Definimos cómo conectar con las personas correctas y generar conversaciones con intención.</p></div>
          <div class="ln-offer-item"><span class="ln-offer-number">03</span><h3>Contenido</h3><p>Creamos una línea de comunicación que demuestra tu conocimiento y fortalece tu autoridad.</p></div>
        </div>
      </div>
    </section>

    <!-- METHOD -->
    <section class="ln-method section-padding">
      <div class="ln-wrap">
        <span class="ln-kicker anim-fade-up">CÓMO FUNCIONA</span>
        <div class="ln-method-heading">
          <h2 class="ln-section-title anim-fade-up anim-delay-1">Tres etapas para construir una presencia con dirección.</h2>
          <p class="ln-method-note">Cada etapa prepara la siguiente. Así construimos una presencia profesional que se sostiene.</p>
        </div>
        <div class="ln-route">
          <svg class="ln-route-line" viewBox="0 0 1000 44" preserveAspectRatio="none" aria-hidden="true"><path class="route-track" d="M0 22 C7 22 11 22 17 22 C110 0 240 44 350 22 C460 0 573 44 683 22 C790 0 900 44 1000 22"></path><path class="route-progress" d="M0 22 C7 22 11 22 17 22 C110 0 240 44 350 22 C460 0 573 44 683 22 C790 0 900 44 1000 22"></path><circle class="route-pulse" r="3"><animateMotion dur="4.8s" repeatCount="indefinite" path="M0 22 C7 22 11 22 17 22 C110 0 240 44 350 22 C460 0 573 44 683 22 C790 0 900 44 1000 22"></animateMotion></circle></svg>
          <div class="ln-route-step anim-fade-up anim-delay-1"><div class="ln-route-marker">01</div><div class="ln-route-copy"><span>Primero</span><h3>Diagnóstico</h3><p>Entendemos quién eres, qué quieres representar y hacia dónde quieres dirigir tu carrera profesional.</p></div></div>
          <div class="ln-route-step anim-fade-up anim-delay-2"><div class="ln-route-marker">02</div><div class="ln-route-copy"><span>Después</span><h3>Posicionamiento</h3><p>Ajustamos tu perfil para comunicar con claridad quién eres y por qué deberían escucharte.</p></div></div>
          <div class="ln-route-step anim-fade-up anim-delay-3"><div class="ln-route-marker">03</div><div class="ln-route-copy"><span>Entonces</span><h3>Visibilidad</h3><p>Construimos una estrategia de contenido y conexión para generar conversaciones relevantes.</p></div></div>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="ln-pricing section-padding" id="diagnostico">
      <div class="ln-wrap">
        <span class="ln-kicker anim-fade-up">CÓMO SE CONTRATA</span>
        <h2 class="ln-section-title anim-fade-up anim-delay-1">Cuatro formas de empezar a construir.</h2>
        <p class="ln-intro anim-fade-up anim-delay-2">Desde encontrar claridad hasta construir una presencia completa, elegimos el punto de partida que tiene sentido para ti.</p>
        <div class="ln-plans ln-plans-simple ln-plans-four anim-fade-up anim-delay-3">
          <div class="ln-plan featured">
            <span class="ln-plan-label">Para empezar</span><div class="plan-name">Claridad inicial</div>
            <p class="ln-plan-summary">Definimos tu dirección profesional antes de construir cualquier cambio.</p>
            <div class="plan-tiers"><div class="plan-tier"><span class="tier-label">Modalidad inicial</span><span class="tier-price">30 USD</span></div><div class="plan-tier"><span class="tier-label">Modalidad personalizada</span><span class="tier-price tbd">A medida</span></div></div>
            <ul><li>Formulario de diagnóstico</li><li>Rol y sector objetivo</li><li>5 temas sobre los que puedes escribir</li><li>Qué te falta, dicho claro</li></ul>
            <span class="plan-note">Entrega en 72 horas</span>
          </div>
          <div class="ln-plan">
            <span class="ln-plan-label">Para construir</span><div class="plan-name">Posicionamiento profesional</div>
            <p class="ln-plan-summary">Convertimos esa dirección en una presencia profesional clara y fiel a tu identidad.</p>
            <div class="plan-tiers"><div class="plan-tier"><span class="tier-label">Modalidad inicial</span><span class="tier-price">70 USD</span></div><div class="plan-tier"><span class="tier-label">Modalidad personalizada</span><span class="tier-price tbd">A medida</span></div></div>
            <ul><li>Todo lo del diagnóstico</li><li>Palabras clave de 10 ofertas reales</li><li>Titular y «Acerca de» reescritos</li><li>Sesión de revisión de 45 minutos</li></ul>
            <span class="plan-note">Entrega en 7 días</span>
          </div>
          <div class="ln-plan"><span class="ln-plan-label">Para equipos</span><div class="plan-name">Construcción colectiva</div><p class="ln-plan-summary">Un mismo impulso para cinco perfiles que quieren avanzar.</p><div class="plan-price-tag">280 USD · 56 por persona</div><ul><li>Diagnóstico individual para cada uno</li><li>Sesión grupal de 2 horas</li><li>Revisión del perfil de cada participante</li><li>Sesión de cierre con métricas</li></ul><span class="plan-note">Si entran cinco, pagan cuatro</span></div>
          <div class="ln-plan"><span class="ln-plan-label">Para compartir</span><div class="plan-name">Clase o masterclass</div><p class="ln-plan-summary">Una sesión práctica para llevar el método a tu equipo.</p><div class="plan-price-tag">120 USD por sesión</div><ul><li>Sesión de 2 horas, online o presencial</li><li>Sin límite de asistentes</li><li>Adaptada a tu público o sector</li><li>Material digital para los asistentes</li></ul><span class="plan-note">Grabación incluida si la necesitas</span></div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ln-cta section-padding">
      <div class="ln-wrap anim-fade-up" style="text-align:center">
        <h2 class="ln-cta-title">Empieza por saber hacia dónde vas.</h2>
        <p class="ln-cta-desc">Una conversación breve para entender tu situación y recomendarte el punto de partida correcto.</p>
        <Button href="https://api.whatsapp.com/send?phone=573133024941&text=Hola%20Kairos%2C%20quiero%20solicitar%20un%20diagn%C3%B3stico%20de%20LinkedIn." external variant="primary">Solicitar diagnóstico</Button>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .ln-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .ln-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    display: block;
  }

  .ln-kicker {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1.25rem;
    display: block;
  }

  .ln-section-title {
    font-family: 'Bricolage Grotesque', var(--font-heading), system-ui, sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    color: var(--color-white);
    max-width: 18ch;
    margin-bottom: 1.25rem;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .ln-intro {
    font-size: 1.15rem;
    max-width: 56ch;
    color: #888;
    line-height: 1.65;
  }

  .ln-highlight {
    background: linear-gradient(transparent 58%, rgba(255, 77, 0, 0.35) 58%);
    padding: 0 0.1em;
  }

  /* ---- HERO ---- */
  .ln-hero {
    background: var(--color-dark);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .ln-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: start;
  }

  .ln-hero h1 {
    font-family: 'Bricolage Grotesque', var(--font-heading), system-ui, sans-serif;
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    font-weight: 800;
    color: var(--color-white);
    max-width: 15ch;
    margin-bottom: 1.5rem;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .ln-lede {
    font-size: 1.15rem;
    max-width: 52ch;
    color: #888;
    line-height: 1.65;
  }

  /* ---- SEARCH MOCK ---- */
  .search-mock {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 18px 40px -28px rgba(0,0,0,0.7);
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
  }

  .search-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-primary);
    flex: none;
  }

  .search-query {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.02em;
  }

  .search-caret {
    display: inline-block;
    width: 7px;
    height: 15px;
    background: var(--color-primary);
    vertical-align: -2px;
    animation: blink 1.05s steps(1) infinite;
    margin-left: 2px;
  }

  @keyframes blink { 50% { opacity: 0 } }

  .search-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .search-chip {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.5);
    padding: 4px 8px;
    border-radius: 4px;
  }

  .search-results { padding: 6px 0 10px; }

  .search-res {
    display: flex;
    gap: 12px;
    padding: 13px 16px;
    align-items: center;
  }

  .res-av {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    flex: none;
  }

  .res-lines { display: flex; flex-direction: column; gap: 5px; }
  .res-ln { height: 8px; background: rgba(255,255,255,0.06); border-radius: 2px; display: block; }
  .res-ln.a { width: 110px; }
  .res-ln.b { width: 172px; height: 7px; }
  .ghost { opacity: 0.55; }

  .search-res.hit {
    background: rgba(255, 77, 0, 0.08);
    border-top: 1px solid rgba(255, 77, 0, 0.2);
    border-bottom: 1px solid rgba(255, 77, 0, 0.2);
    opacity: 0;
    transform: translateY(6px);
    animation: pop 0.5s ease-out 2.1s forwards;
  }

  @keyframes pop { to { opacity: 1; transform: none } }

  .hit-av { background: var(--color-primary) !important; }
  .res-name { font-family: var(--font-heading); font-weight: 600; font-size: 0.9rem; color: var(--color-white); display: block; }

  /* ---- OFFER / REFINED SECTIONS ---- */
  .ln-offer { background: var(--color-white); color: var(--color-dark); }
  .ln-section-title-dark { color: var(--color-dark); }
  .ln-intro-dark { color: var(--color-gray); }
  .ln-offer-grid {
    margin-top: 2.75rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-gray-light);
    border-top: 1px solid var(--color-gray-light);
    border-bottom: 1px solid var(--color-gray-light);
  }
  .ln-offer-item { background: var(--color-white); padding: 1.75rem 1.5rem 2rem; }
  .ln-offer-number { color: var(--color-primary); font-family: var(--font-heading); font-size: .75rem; letter-spacing: .12em; }
  .ln-offer-item h3 { color: var(--color-dark); font-size: 1.3rem; margin: 1.15rem 0 .55rem; }
  .ln-offer-item p { color: var(--color-gray); max-width: 30ch; line-height: 1.6; }
  .ln-process-list { margin-top: 2.5rem; border-top: 1px solid rgba(255,255,255,.16); }
  .ln-process-step { display: grid; grid-template-columns: 72px 1fr; gap: 1.5rem; padding: 1.45rem 0; border-bottom: 1px solid rgba(255,255,255,.1); }
  .ln-process-step > span { color: var(--color-primary); font-family: var(--font-heading); font-size: 1.3rem; font-weight: 800; }
  .ln-process-step h3 { color: var(--color-white); font-size: 1.25rem; margin-bottom: .4rem; }
  .ln-process-step p { color: #888; line-height: 1.6; }
  .ln-method-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .ln-method-note { color: #777; max-width: 30ch; font-size: .9rem; line-height: 1.5; }
  .ln-route { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 3.5rem; }
  .ln-route-line { position: absolute; top: 0; left: 0; right: 0; width: 100%; height: 44px; overflow: visible; }
  .route-track, .route-progress { fill: none; stroke-linecap: round; stroke-width: 1.2; }
  .route-track { stroke: rgba(255,255,255,.16); }
  .route-progress { stroke: var(--color-primary); stroke-width: 1.8; stroke-dasharray: 3000; stroke-dashoffset: 3000; animation: routeDraw 3.6s cubic-bezier(.22,.8,.28,1) .25s forwards; }
  .route-pulse { fill: var(--color-primary); filter: drop-shadow(0 0 5px rgba(255,77,0,.8)); animation: routePulse 4.8s ease-in-out 3.8s infinite; }
  @keyframes routeDraw { to { stroke-dashoffset: 0; } }
  @keyframes routePulse { 0%, 100% { opacity: 0; } 8%, 88% { opacity: 1; } }
  .ln-route-step { position: relative; z-index: 1; }
  .ln-route-marker { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--color-primary); color: var(--color-dark); font-family: var(--font-heading); font-weight: 800; box-shadow: 0 0 0 8px var(--color-dark); }
  .ln-route-copy { padding-top: 1.4rem; }
  .ln-route-copy > span { color: var(--color-primary); font-family: var(--font-heading); font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; }
  .ln-route-copy h3 { color: var(--color-white); font-size: 1.25rem; margin: .45rem 0 .45rem; }
  .ln-route-copy p { color: #999; max-width: 30ch; line-height: 1.55; font-size: .9rem; }
  .ln-proof.ln-proof-compact { background: var(--color-light); border-bottom-color: var(--color-gray-light); }
  .ln-proof.ln-proof-compact .ln-kicker { color: var(--color-primary); }
  .ln-plans-simple { max-width: 900px; margin-left: auto; margin-right: auto; }
  .ln-plans-simple .ln-plan { min-height: 100%; }
  .ln-plans-simple .ln-plan.featured { border: 1px solid var(--color-primary); }
  .ln-plan-label { display: block; color: var(--color-primary); font-family: var(--font-heading); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; margin-bottom: .6rem; }
  .ln-plan-summary { color: #aaa; line-height: 1.55; min-height: 3.1em; margin-bottom: 1.1rem; }
  .ln-plans-simple .ln-plan { background: #1a1a1a; border: 1px solid rgba(255,255,255,.12); }
  .ln-plans-simple .ln-plan.featured { background: #21160f; border-color: var(--color-primary); }
  .ln-plans-four { max-width: 1000px; }
  .ln-plans-simple .ln-plan ul { color: #b8b8b8; }
  .ln-plans-simple .tier-label { color: #aaa; }
  .ln-plans-simple .plan-note { color: #888; }
  .res-role { font-family: var(--font-heading); font-size: 0.7rem; color: #888; display: block; margin-top: 3px; }
  .res-info { display: flex; flex-direction: column; }
  .res-tag {
    margin-left: auto;
    font-family: var(--font-heading);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-dark);
    background: var(--color-primary);
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  .search-foot {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    color: #555;
    padding: 11px 16px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  /* ---- DATA ---- */
  .ln-data {
    background: #111;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .data-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    overflow: hidden;
  }

  .data-cell {
    background: #111;
    padding: 1.75rem 1.4rem;
  }

  .data-fig {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2rem, 4.4vw, 2.8rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-white);
  }

  .data-fig em {
    font-style: normal;
    color: var(--color-primary);
  }

  .data-lab {
    font-size: 0.75rem;
    line-height: 1.55;
    color: #666;
    margin-top: 0.75rem;
  }

  .ln-close {
    margin-top: 2.75rem;
    font-size: 1.2rem;
    max-width: 54ch;
    color: var(--color-white);
    line-height: 1.5;
  }

  .ln-source {
    margin-top: 1.5rem;
    font-size: 0.7rem;
    color: #555;
    letter-spacing: 0.02em;
  }

  /* ---- PROOF ---- */
  .ln-proof {
    background: var(--color-dark);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .bars {
    margin-top: 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 760px;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 190px 1fr 106px;
    align-items: center;
    gap: 1rem;
  }

  .bar-lab {
    font-size: 0.75rem;
    color: #666;
    text-align: right;
  }

  .bar-track {
    height: 26px;
    background: rgba(255,255,255,0.06);
    border-radius: 4px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: var(--color-primary);
    width: 0;
    border-radius: 4px;
    animation: grow 1.05s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }

  .bar-fill.small { background: #555; }

  @keyframes grow { to { width: var(--w) } }

  .bar-num {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--color-white);
  }

  .ln-readout {
    margin-top: 2.25rem;
    font-size: 1.15rem;
    max-width: 50ch;
    color: #aaa;
    line-height: 1.6;
  }

  /* ---- WHO ---- */
  .ln-who-section {
    background: var(--color-dark);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .ln-who-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .ln-photo {
    aspect-ratio: 4/5;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: #555;
