---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AboutHero from '../components/sections/AboutHero.astro';
import AboutPhilosophy from '../components/sections/AboutPhilosophy.astro';
import AboutAudience from '../components/sections/AboutAudience.astro';
import AboutValues from '../components/sections/AboutValues.astro';
import Team from '../components/sections/Team.astro';
import Cta from '../components/sections/Cta.astro';
---

	<Layout title="Quiénes somos | KAIROS" description="Conoce a KAIROS, un equipo que acompaña a líderes y organizaciones a construir con identidad, dirección y propósito.">
	<Header />
	<main>
		<AboutHero />
		<AboutPhilosophy />
		<AboutAudience />
		<AboutValues />
		<Team variant="aboutTeam" />
		<Cta />
	</main>
	<Footer />
</Layout>
