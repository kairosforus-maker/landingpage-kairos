---
import Button from '../ui/Button.astro';
import { getLangFromUrl, content } from '../../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = content[lang].hero;

const titleParts = t.title.split(t.highlight);
---

<section class="hero" style={`background-image: url('/backgorund.webp');`}>
  <div class="hero-overlay"></div>

  <div class="hero-inner">
    <div class="hero-content">
      <span class="hero-tag hero-anim hero-anim-1">{t.tag}</span>
      <h1 class="hero-title hero-anim hero-anim-2">
        {titleParts[0]}<span class="hero-hl">{t.highlight}</span>{titleParts[1] || ''}
      </h1>
      <p class="hero-desc hero-anim hero-anim-3">{t.desc}</p>
      <div class="hero-actions hero-anim hero-anim-4">
        <Button href="https://cal.com/kairos4us/30min" onclick="event.preventDefault();" data-cal-link="kairos4us/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' variant="primary">
          {t.btnTalk}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="margin-left:6px;display:inline-block;vertical-align:middle;">
            <path d="M1 13L13 1M13 1H3M13 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </Button>
        <button class="btn-secondary" onclick="document.getElementById('proceso')?.scrollIntoView({behavior:'smooth'})">
          <span class="btn-arrow">→</span> {t.btnCta}
        </button>
      </div>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.7) 40%, rgba(10,10,10,0.2) 70%, transparent 100%),
      linear-gradient(to top, rgba(10,10,10,0.5) 0%, transparent 40%);
    z-index: 1;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: center;
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 6rem 4rem 4rem;
  }

  .hero-content {
    max-width: 580px;
  }

  .hero-tag {
    font-family: var(--font-heading);
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    display: block;
  }

  .hero-title {
    font-size: clamp(2.75rem, 5vw, 4.25rem);
    color: var(--color-white);
    line-height: 1.08;
    margin-bottom: 1.5rem;
    font-weight: 700;
  }

  .hero-hl {
    color: var(--color-primary);
  }

  .hero-desc {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    max-width: 460px;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.7);
    padding: 0.8rem 0;
    font-size: 0.95rem;
    font-family: var(--font-body);
    cursor: pointer;
    transition: color 0.3s;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .btn-secondary:hover {
    color: var(--color-white);
  }

  .btn-arrow {
    color: var(--color-primary);
    font-size: 1.1rem;
    transition: transform 0.3s;
  }

  .btn-secondary:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Animations */
  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-anim {
    opacity: 0;
    animation: heroFadeUp 0.7s ease forwards;
  }
  .hero-anim-1 { animation-delay: 0.1s; }
  .hero-anim-2 { animation-delay: 0.22s; }
  .hero-anim-3 { animation-delay: 0.36s; }
  .hero-anim-4 { animation-delay: 0.5s; }

  @media (prefers-reduced-motion: reduce) {
    .hero-anim { opacity: 1; animation: none; }
  }


  @media (max-width: 992px) {
    .hero-inner {
      padding: 6rem 2rem 3rem;
    }

    .hero-overlay {
      background:
        linear-gradient(to bottom, rgba(10,10,10,0.85) 0%, rgba(10,10,10,0.5) 50%, rgba(10,10,10,0.3) 100%);
    }

    .hero-bar {
      padding: 1rem 2rem;
    }

    .hero-bar-inner {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }

    .hero-bar-left { justify-content: center; }
  }

  @media (max-width: 600px) {
    .hero-inner {
      padding: 5rem 1.25rem 2.5rem;
    }

    .hero-bar {
      padding: 1rem 1.25rem;
    }

    .hero-title {
      font-size: clamp(2.25rem, 8vw, 3rem);
    }
  }
</style>
