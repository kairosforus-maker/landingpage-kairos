---
import { getLangFromUrl, content } from '../../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = content[lang].methodology;
---

<section class="methodology section-padding">
  <div class="methodology-inner">
    <div class="methodology-header">
      <span class="tag-subtitle">{t.tag}</span>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-text">{t.desc}</p>
    </div>

    <div class="bento-grid">
      <div class="bento-cell cell-marketing bento-card has-media">
        <div class="bento-card-content">
          <span class="sphere-number">{t.spheres[0].number}</span>
          <h3 class="sphere-title">{t.spheres[0].title}</h3>
          <p class="sphere-desc">{t.spheres[0].desc}</p>
          <p class="sphere-example">{t.spheres[0].example}</p>
        </div>
        <div class="bento-thumb">
          <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&q=80" alt="Marketing" loading="lazy" />
        </div>
      </div>

      <div class="bento-cell cell-hero">
        <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=800&q=80" alt="Equipo trabajando" loading="lazy" />
      </div>

      <div class="bento-cell cell-personas bento-card">
        <span class="sphere-number">{t.spheres[1].number}</span>
        <h3 class="sphere-title">{t.spheres[1].title}</h3>
        <p class="sphere-desc">{t.spheres[1].desc}</p>
        <p class="sphere-example">{t.spheres[1].example}</p>
      </div>

      <div class="bento-cell cell-liderazgo bento-card bento-dark">
        <span class="sphere-number">{t.spheres[2].number}</span>
        <h3 class="sphere-title">{t.spheres[2].title}</h3>
        <p class="sphere-desc">{t.spheres[2].desc}</p>
        <p class="sphere-example">{t.spheres[2].example}</p>
      </div>

      <div class="bento-cell cell-operaciones bento-card has-media">
        <div class="bento-card-content">
          <span class="sphere-number">{t.spheres[3].number}</span>
          <h3 class="sphere-title">{t.spheres[3].title}</h3>
          <p class="sphere-desc">{t.spheres[3].desc}</p>
          <p class="sphere-example">{t.spheres[3].example}</p>
        </div>
        <div class="bento-thumb">
          <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=400&q=80" alt="Colaboración" loading="lazy" />
        </div>
      </div>

      <div class="bento-cell cell-tecnologia bento-card bento-dark has-media">
        <div class="bento-card-content">
          <span class="sphere-number">{t.spheres[4].number}</span>
          <h3 class="sphere-title">{t.spheres[4].title}</h3>
          <p class="sphere-desc">{t.spheres[4].desc}</p>
          <p class="sphere-example">{t.spheres[4].example}</p>
        </div>
        <div class="bento-thumb">
          <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=400&q=80" alt="Tecnología" loading="lazy" />
        </div>
      </div>

      <div class="bento-cell cell-finanzas bento-card has-media">
        <div class="bento-card-content">
          <span class="sphere-number">{t.spheres[5].number}</span>
          <h3 class="sphere-title">{t.spheres[5].title}</h3>
          <p class="sphere-desc">{t.spheres[5].desc}</p>
          <p class="sphere-example">{t.spheres[5].example}</p>
        </div>
        <div class="bento-thumb">
          <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=400&q=80" alt="Trabajo en equipo" loading="lazy" />
        </div>
      </div>

      <div class="bento-cell cell-social bento-card bento-accent">
        <div class="bento-card-content">
          <span class="sphere-number">{t.spheres[6].number}</span>
          <h3 class="sphere-title">{t.spheres[6].title}</h3>
          <p class="sphere-desc">{t.spheres[6].desc}</p>
          <p class="sphere-example">{t.spheres[6].example}</p>
        </div>
        <div class="bento-image-fill">
          <img src="https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&fit=crop&w=800&q=80" alt="Impacto social" loading="lazy" />
        </div>
      </div>
    </div>

    <div class="methodology-footer">
      <p>{t.footer}</p>
    </div>
  </div>
</section>

<style>
  .methodology {
    background-color: var(--color-light);
  }

  .methodology-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.6rem;
  }

  .methodology-header {
    text-align: center;
    max-width: 800px;
    width: 100%;
  }

  .section-title {
    font-size: clamp(2.18rem, 4vw, 3rem);
    margin-bottom: 1rem;
    color: var(--color-dark);
  }

  .section-text {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--color-gray);
    line-height: 1.6;
  }

  /* ── Bento Grid ── */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr 1.4fr;
    gap: 16px;
    width: 100%;
    align-items: stretch;
  }

  .bento-cell {
    border-radius: 20px;
    overflow: hidden;
    min-height: 180px;
  }

  .cell-marketing     { grid-column: 1 / 3; grid-row: 1; }
  .cell-hero          { grid-column: 3 / 5; grid-row: 1 / 3; min-height: 420px; }
  .cell-personas      { grid-column: 1; grid-row: 2; }
  .cell-liderazgo     { grid-column: 2; grid-row: 2; }
  .cell-operaciones   { grid-column: 1 / 3; grid-row: 3; }
  .cell-tecnologia    { grid-column: 3 / 5; grid-row: 3; }
  .cell-finanzas      { grid-column: 1 / 3; grid-row: 4; }
  .cell-social        { grid-column: 3 / 5; grid-row: 4; }

  /* ── Card base ── */
  .bento-card {
    padding: 20px 22px 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    background: var(--color-white);
    border: 1px solid var(--color-gray-light);
    transition: border-color 0.3s ease, transform 0.3s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }

  .bento-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-3px);
  }

  .has-media {
    flex-direction: row;
    align-items: center;
    gap: 18px;
    min-height: 182px;
  }

  .bento-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .bento-thumb {
    width: 138px;
    height: 110px;
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .bento-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Hero image cell ── */
  .cell-hero {
    position: relative;
    background: var(--color-gray-light);
  }

  .cell-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .cell-hero:hover img {
    transform: scale(1.05);
  }

  /* ── Dark variant ── */
  .bento-dark {
    background: var(--color-dark);
    border-color: #1E1E1E;
  }

  .bento-dark .sphere-title {
    color: var(--color-white);
  }

  .bento-dark .sphere-desc {
    color: #a0a0a0;
  }

  .bento-dark .sphere-example {
    color: #666;
  }

  /* ── Accent (orange) variant ── */
  .bento-accent {
    background: var(--color-primary);
    border-color: var(--color-primary);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
    align-items: center;
    gap: 24px;
    min-height: 210px;
    padding: 24px 28px;
  }

  .bento-accent .sphere-number {
    color: rgba(255,255,255,0.7);
  }

  .bento-accent .sphere-title {
    color: var(--color-white);
    font-size: clamp(2rem, 2.2vw, 2.8rem);
    line-height: 1.05;
    margin: 0;
  }

  .bento-accent .sphere-desc {
    color: rgba(255,255,255,0.85);
    max-width: 480px;
    margin: 0;
  }

  .bento-accent .sphere-example {
    color: rgba(255,255,255,0.6);
  }

  /* ── Social row image ── */
  .bento-image-fill {
    width: 100%;
    max-width: 390px;
    min-width: 240px;
    height: 220px;
    border-radius: 18px;
    overflow: hidden;
    justify-self: end;
  }

  .bento-image-fill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Text styles ── */
  .sphere-number {
    font-family: var(--font-heading);
    color: var(--color-primary);
    font-weight: 700;
    font-size: 1rem;
    display: block;
  }

  .sphere-title {
    font-size: clamp(1.2rem, 1.3vw, 1.8rem);
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.15;
  }

  .sphere-desc {
    color: var(--color-gray);
    font-size: 1rem;
    line-height: 1.55;
    font-weight: 500;
  }

  .sphere-example {
    color: var(--color-gray);
    opacity: 0.7;
    font-size: 0.9rem;
    line-height: 1.5;
    font-style: italic;
  }

  .methodology-footer {
    text-align: center;
    font-size: 1.125rem;
    color: var(--color-primary);
    max-width: 800px;
    font-weight: 500;
  }

  /* ── Tablet ── */
  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: 1fr 1fr;
    }

    .cell-marketing,
    .cell-hero,
    .cell-personas,
    .cell-liderazgo,
    .cell-operaciones,
    .cell-tecnologia,
    .cell-finanzas,
    .cell-social {
      grid-column: auto;
      grid-row: auto;
    }

    .cell-marketing,
    .cell-hero,
    .cell-social {
      grid-column: 1 / 3;
    }

    .cell-hero {
      min-height: 260px;
    }

    .bento-card.has-media {
      flex-direction: column;
      align-items: flex-start;
    }

    .bento-thumb {
      width: 100%;
      height: 140px;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }

    .cell-marketing,
    .cell-hero,
    .cell-personas,
    .cell-liderazgo,
    .cell-operaciones,
    .cell-tecnologia,
    .cell-finanzas,
    .cell-social {
      grid-column: 1;
      grid-row: auto;
    }

    .cell-hero {
      display: none;
    }

    .bento-accent {
      grid-template-columns: 1fr;
      align-items: flex-start;
      padding: 20px 20px 18px;
    }

    .bento-image-fill {
      display: none;
    }
  }
</style>
