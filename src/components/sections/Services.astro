---
import { getLangFromUrl, content } from '../../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = content[lang].services;

const serviceKeys = ['builder', 'digital', 'linkedin'] as const;
const prefix = lang === 'es' ? '' : '/en';
const hrefs = {
  builder: `${prefix}/servicios/builder`,
  digital: `${prefix}/servicios/digital`,
  linkedin: `${prefix}/servicios/linkedin`,
};

const icons = {
  builder: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="10" height="10" rx="2"/><rect x="15" y="3" width="10" height="10" rx="2"/><rect x="3" y="15" width="10" height="10" rx="2"/></svg>`,
  digital: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="20" height="18" rx="2.5"/><line x1="4" y1="21" x2="24" y2="21"/><line x1="14" y1="21" x2="14" y2="25"/><line x1="10" y1="25" x2="18" y2="25"/></svg>`,
  linkedin: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="22" height="22" rx="4"/><text x="9" y="20" font-size="14" font-weight="700" fill="currentColor" stroke="none" font-family="sans-serif">in</text></svg>`,
};

const services = serviceKeys.map(key => ({
  data: t[key],
  href: hrefs[key],
  icon: icons[key],
}));

const titleParts = t.title.split(t.titleHighlight);
---

<section id="servicios" class="services">
  <div class="services-inner">
    <div class="services-header anim-fade-up">
      <span class="services-tag">{t.tag}</span>
      <h2 class="services-title">
        {titleParts[0]}<span class="services-hl">{t.titleHighlight}</span>{titleParts[1] || ''}
      </h2>
      <p class="services-desc">{t.desc}</p>
    </div>

    <div class="services-grid">
      {services.map((s, i) => (
        <a href={s.href} class={`service-block anim-fade-up anim-delay-${i + 1}`}>
          <div class="service-number">{s.data.number}</div>
          <div class="service-icon" set:html={s.icon} />
          <h3 class="service-name">{s.data.title}</h3>
          <div class="service-divider"></div>
          <p class="service-text">{s.data.desc}</p>
          <span class="service-link">
            {t.viewMore}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: #fafafa;
    padding: 7rem 4rem;
  }

  .services-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .services-header {
    max-width: 640px;
    margin-bottom: 5rem;
  }

  .services-tag {
    font-family: var(--font-heading);
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    display: block;
  }

  .services-title {
    font-size: clamp(2.25rem, 4vw, 3rem);
    color: var(--color-dark, #0a0a0a);
    line-height: 1.12;
    margin-bottom: 1.25rem;
    font-weight: 700;
  }

  .services-hl {
    color: var(--color-primary);
  }

  .services-desc {
    font-size: 1.05rem;
    color: #666;
    line-height: 1.65;
    max-width: 520px;
  }

  /* Grid — 3 columns editorial */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid #e0e0e0;
  }

  .service-block {
    padding: 3rem 2.5rem 3rem 0;
    border-right: 1px solid #e0e0e0;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: background 0.3s;
  }

  .service-block:last-child {
    border-right: none;
    padding-right: 0;
  }

  .service-block:first-child {
    padding-left: 0;
  }

  .service-block:nth-child(2) {
    padding-left: 2.5rem;
  }

  .service-block:nth-child(3) {
    padding-left: 2.5rem;
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 300;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .service-icon {
    color: var(--color-primary);
    margin-bottom: 1.25rem;
    opacity: 0.8;
  }

  .service-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-dark, #0a0a0a);
    margin-bottom: 0;
    line-height: 1.2;
  }

  .service-divider {
    width: 32px;
    height: 2px;
    background: var(--color-primary);
    margin: 1rem 0;
    opacity: 0.7;
    transition: width 0.3s;
  }

  .service-block:hover .service-divider {
    width: 48px;
  }

  .service-text {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    margin-top: auto;
  }

  .service-link svg {
    transition: transform 0.3s;
  }

  .service-block:hover .service-link svg {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .services {
      padding: 5rem 2rem;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-block {
      border-right: none;
      border-bottom: 1px solid #e0e0e0;
      padding: 2.5rem 0;
    }

    .service-block:last-child {
      border-bottom: none;
    }

    .service-block:nth-child(2),
    .service-block:nth-child(3) {
      padding-left: 0;
    }
  }

  @media (max-width: 600px) {
    .services {
      padding: 4rem 1.25rem;
    }

    .services-header {
      margin-bottom: 3rem;
    }
  }
</style>
