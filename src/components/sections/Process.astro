---
import { getLangFromUrl, content } from '../../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = content[lang].process;

const stepImages = [
  '/cafe.webp',
  '/img-process-2.jpg',
  '/img-process-3.jpg',
];
---

<section id="proceso" class="process section-padding">
  <div class="process-inner">
    <div class="process-header anim-fade-up">
      <span class="tag-subtitle">{t.tag}</span>
      <span class="heading-rule" aria-hidden="true"></span>
      <h2 class="section-title">{t.title.replace(t.highlight, '')}<span class="title-highlight">{t.highlight}</span></h2>
      <p class="process-desc">{t.desc}</p>
    </div>

    <div class="steps-row">
      {t.steps.map((step, i) => (
        <article class={`step anim-fade-up anim-delay-${i + 1}`}>
          <div class="step-image">
            <img src={stepImages[i]} alt={step.title} />
          </div>
          <div class="step-marker">
            <div class="step-number">{step.number}</div>
          </div>
          <div class="step-content">
            <h3 class="step-title">{step.title}</h3>
            <span class="step-rule" aria-hidden="true"></span>
            <p class="step-desc">{step.desc}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .process {
    background-color: var(--color-white);
    color: var(--color-dark);
  }

  .process-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.25rem;
  }

  .process-header {
    text-align: center;
    max-width: 900px;
  }

  .process-header .tag-subtitle {
    color: var(--color-primary);
    display: block;
  }

  .heading-rule {
    display: block;
    width: 48px;
    height: 1px;
    margin: 1.35rem auto 1.8rem;
    background: var(--color-primary);
  }

  .process-header .section-title {
    font-size: clamp(2.2rem, 4vw, 3.65rem);
    color: var(--color-dark);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .title-highlight {
    color: var(--color-primary);
  }

  .process-desc {
    max-width: 48ch;
    margin: 1.35rem auto 0;
    color: var(--color-gray);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .steps-row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    gap: 0;
  }

  .step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .step-image {
    border-radius: 14px;
    overflow: hidden;
    width: calc(100% - 2rem);
    aspect-ratio: 1.7;
    max-height: 220px;
    border-radius: 16px;
  }

  .step-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .step:hover .step-image img {
    transform: scale(1.05);
  }

  .step-marker {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    position: relative;
    width: 100%;
  }

  .step:not(:last-child) .step-marker::after {
    content: '';
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 1px;
    background: var(--color-primary);
    transform: translateY(-50%);
  }

  .step-number {
    width: 56px;
    height: 56px;
    min-width: 56px;
    border-radius: 50%;
    background: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    box-shadow: 0 0 22px rgba(255, 77, 0, 0.22);
    position: relative;
    z-index: 1;
  }

  .step-content {
    padding: 0 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .step-title {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.3;
  }

  .step-desc {
    color: var(--color-gray);
    font-size: 0.94rem;
    line-height: 1.55;
    max-width: 31ch;
  }

  .step-rule {
    width: 38px;
    height: 1px;
    margin: 0.35rem auto 0.25rem;
    background: var(--color-primary);
  }

  @media (max-width: 768px) {
    .steps-row {
      grid-template-columns: 1fr;
      gap: 2.4rem;
      padding-left: 0;
    }

    .steps-row::before {
      content: '';
      position: absolute;
      z-index: 0;
      top: 230px;
      bottom: 135px;
      left: 1.5rem;
      right: auto;
      width: 1px;
      height: auto;
      background: var(--color-primary);
    }

    .step:not(:last-child) .step-marker::after {
      display: none;
    }

    .step-image {
      margin: 0;
      width: 100%;
      max-height: none;
      aspect-ratio: 1.65;
    }

    .step-marker {
      justify-content: flex-start;
      height: 48px;
    }

    .step-number {
      width: 48px;
      height: 48px;
      min-width: 48px;
      font-size: 1rem;
    }

    .step-content {
      padding: 0 0 0 4.5rem;
      align-items: flex-start;
      text-align: left;
    }

    .step-rule {
      margin-left: 0;
    }

    .step-desc {
      max-width: 48ch;
    }

  }
</style>
