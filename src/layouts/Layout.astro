---
import { getLangFromUrl } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);

interface Props {
	title?: string;
	description?: string;
	image?: string;
	url?: string;
	schemaType?: 'ProfessionalService' | 'Service' | 'WebPage' | 'BlogPosting';
	publishedAt?: string;
	robots?: string;
}

const {
	title = 'KAIROS | Construcción empresarial, estrategia y soluciones digitales',
	description = 'KAIROS ayuda a empresas y organizaciones a convertir retos empresariales en soluciones mediante estrategia, formación, ejecución y tecnología.',
	image = '/og-image.png',
	url,
	schemaType = 'WebPage',
	publishedAt,
	robots = 'index, follow',
} = Astro.props;

const siteBase = 'https://www.kairos4us.com';
const pathWithoutLang = Astro.url.pathname.replace(/^\/(en)\/?/, '/');
const esUrl = `${siteBase}${pathWithoutLang}`;
const enUrl = `${siteBase}/en${pathWithoutLang === '/' ? '/' : pathWithoutLang}`;
const canonicalUrl = url || `${siteBase}${Astro.url.pathname}`;
const imageUrl = image.startsWith('http') ? image : `${siteBase}${image}`;
const isSpanish = lang === 'es';
const schema = schemaType === 'ProfessionalService'
	? {
			'@context': 'https://schema.org',
			'@type': 'ProfessionalService',
			'@id': `${siteBase}/#organization`,
			'name': 'KAIROS',
			'alternateName': 'Kairos',
			'description': isSpanish
				? 'Constructora de propósito. Estrategia empresarial, formación, ejecución y soluciones digitales para empresas y organizaciones.'
				: 'Purpose-driven partner for business strategy, training, execution, and digital solutions.',
			'url': siteBase,
			'logo': `${siteBase}/loguito.png`,
			'image': `${siteBase}/og-image.png`,
			'email': 'weare@comkairos.com',
			'telephone': '+573133024941',
			'address': { '@type': 'PostalAddress', 'addressCountry': 'CO' },
			'sameAs': [
				'https://www.linkedin.com/in/albertomarioguzmanestrada/',
				'https://www.linkedin.com/in/geovanipg/'
			],
			'areaServed': { '@type': 'Country', 'name': 'Colombia' },
			'contactPoint': { '@type': 'ContactPoint', 'telephone': '+573133024941', 'contactType': 'sales', 'availableLanguage': ['Spanish', 'English'] },
			'inLanguage': isSpanish ? 'es-CO' : 'en'
		}
	: schemaType === 'Service'
		? {
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${canonicalUrl}#service`,
			'name': title.split('|')[0].trim(),
			'description': description,
			'url': canonicalUrl,
			'provider': { '@id': `${siteBase}/#organization`, '@type': 'ProfessionalService', 'name': 'KAIROS', 'url': siteBase },
			'areaServed': { '@type': 'Country', 'name': 'Colombia' },
			'inLanguage': isSpanish ? 'es-CO' : 'en'
		}
	: schemaType === 'BlogPosting'
		? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			'@id': `${canonicalUrl}#article`,
			'headline': title,
			'description': description,
			'url': canonicalUrl,
			'image': imageUrl,
			'datePublished': publishedAt,
			'author': { '@type': 'Organization', 'name': 'KAIROS', 'url': siteBase },
			'publisher': { '@id': `${siteBase}/#organization`, '@type': 'Organization', 'name': 'KAIROS', 'logo': { '@type': 'ImageObject', 'url': `${siteBase}/loguito.png` } },
			'inLanguage': isSpanish ? 'es-CO' : 'en'
		}
		: {
			'@context': 'https://schema.org',
			'@type': 'WebPage',
			'@id': `${canonicalUrl}#webpage`,
			'name': title,
			'description': description,
			'url': canonicalUrl,
			'inLanguage': isSpanish ? 'es-CO' : 'en',
			'isPartOf': { '@type': 'WebSite', 'name': 'KAIROS', 'url': siteBase }
		};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico?v=2" type="image/x-icon" sizes="16x16 32x32 48x48" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="2pP3gRhMcxz5Sl5XZi17gk5VbY9S6J82IgAxvMVbGTs" />
		
		<!-- SEO Basics -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="theme-color" content="#FF4D00" />

		<!-- Hreflang -->
		<link rel="alternate" hreflang="es-CO" href={esUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={esUrl} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
		<meta property="og:site_name" content="KAIROS" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Sora:wght@100..800&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />

		<!-- Floating WhatsApp Button -->
		<a 
			href="https://api.whatsapp.com/send?phone=573133024941&text=Hola%2C%20quiero%20agendar%20una%20conversaci%C3%B3n%20con%20Kairos." 
			target="_blank" 
			rel="noopener noreferrer" 
			class="whatsapp-float"
			id="whatsappFloat"
			aria-label="Chat on WhatsApp"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
			</svg>
		</a>

		<!-- Back to Top Button -->
		<button class="back-to-top" id="backToTop" aria-label="Back to top">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="18 15 12 9 6 15"></polyline>
			</svg>
		</button>

		<!-- Cookie Consent Banner -->
		<div class="cookie-banner" id="cookieBanner">
			<p class="cookie-text">
				{lang === 'es'
					? 'Usamos cookies para mejorar tu experiencia. Al continuar, aceptas nuestra '
					: 'We use cookies to improve your experience. By continuing, you accept our '}
				<a href={lang === 'es' ? '/privacidad' : '/en/privacy'}>
					{lang === 'es' ? 'política de privacidad' : 'privacy policy'}
				</a>.
			</p>
			<div class="cookie-actions">
				<button class="cookie-btn cookie-accept" id="cookieAccept">
					{lang === 'es' ? 'Aceptar' : 'Accept'}
				</button>
				<button class="cookie-btn cookie-reject" id="cookieReject">
					{lang === 'es' ? 'Solo esenciales' : 'Essential only'}
				</button>
			</div>
		</div>

		<!-- Scroll Reveal Observer + Back to Top + Cookie Banner -->
		<script>
		  // Scroll reveal
		  const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
			  if (entry.isIntersecting) {
				entry.target.classList.add('is-visible');
				observer.unobserve(entry.target);
			  }
			});
		  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
		  document.querySelectorAll('.anim-fade-up, .anim-fade-in, .anim-slide-left, .anim-slide-right').forEach(el => observer.observe(el));

		  // Back to top
		  const btn = document.getElementById('backToTop');
		  btn?.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		  });

		  // Floating WhatsApp — only appears past the hero / first fold
		  const wa = document.getElementById('whatsappFloat');
		  const hero = document.querySelector<HTMLElement>('.hero');
		  const getThreshold = () => hero ? hero.offsetHeight - 120 : 600;
		  const onScroll = () => {
			const past = window.scrollY > getThreshold();
			btn?.classList.toggle('visible', window.scrollY > 600);
			if (wa) wa.classList.toggle('visible', past);
		  };
		  window.addEventListener('scroll', onScroll, { passive: true });
		  onScroll();

		  // Cookie banner
		  const banner = document.getElementById('cookieBanner');
		  if (!localStorage.getItem('kairos-cookies')) {
			setTimeout(() => banner?.classList.add('visible'), 1500);
		  }
		  document.getElementById('cookieAccept')?.addEventListener('click', () => {
			localStorage.setItem('kairos-cookies', 'all');
			banner?.classList.remove('visible');
		  });
		  document.getElementById('cookieReject')?.addEventListener('click', () => {
			localStorage.setItem('kairos-cookies', 'essential');
			banner?.classList.remove('visible');
		  });
		</script>

		<!-- Cal.com Modal Script -->
		<script>
		  type CalApi = ((...args: unknown[]) => void) & { loaded?: boolean; ns?: Record<string, unknown>; q?: unknown[] };
		  const calWindow = window as Window & { Cal?: CalApi };
		  (function (C, A, L) { const p = (a: CalApi, ar: IArguments) => { a.q = a.q || []; a.q.push(ar); }; const d = C.document; C.Cal = C.Cal || function (...args: unknown[]) { const cal = C.Cal as CalApi; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (args[0] === L) { const api = function (...apiArgs: unknown[]) { p(api, apiArgs as unknown as IArguments); } as CalApi; const namespace = args[1]; api.q = api.q || []; typeof namespace === "string" ? (cal.ns![namespace] = cal.ns![namespace] || api) : p(cal, args as unknown as IArguments); return; } p(cal, args as unknown as IArguments); }; })(calWindow, "https://app.cal.com/embed/embed.js", "init");
		  
		  // Inicializa el modal
		  calWindow.Cal?.("init", "30min", {origin:"https://cal.com"});
		  
		  // Opcional: Personaliza los colores para que combinen con la marca
		  calWindow.Cal?.("ui", {"styles":{"branding":{"brandColor":"#FF4D00"}},"hideEventTypeDetails":false,"layout":"month_view"});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--color-primary: #FF4D00;
		--color-accent: #FF4D00;
		--color-dark: #0A0A0A;
		--color-light: #FAFAF8;
		--color-gray: #3A3A3A;
		--color-gray-light: #E8E4DF;
		--color-white: #FFFFFF;

		--font-heading: 'Sora', sans-serif;
		--font-body: 'DM Sans', sans-serif;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: var(--font-body);
		background-color: var(--color-light);
		color: var(--color-dark);
		scroll-behavior: smooth;
	}

	body {
		min-height: 100vh;
		overflow-x: hidden;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-heading);
		font-weight: 600;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	.btn-primary {
		display: inline-block;
		background-color: var(--color-primary);
		color: var(--color-light);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1rem;
		padding: 1rem 2.25rem;
		border-radius: 99px;
		border: 1px solid var(--color-primary);
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.btn-primary:hover {
		background-color: transparent;
		color: var(--color-primary);
	}

	.btn-outline {
		display: inline-block;
		background-color: transparent;
		color: var(--color-primary);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1rem;
		padding: 1rem 2.25rem;
		border-radius: 99px;
		border: 1px solid var(--color-primary);
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.btn-outline:hover {
		background-color: var(--color-primary);
		color: var(--color-light);
	}

	.btn-outline-white {
		display: inline-block;
		background-color: transparent;
		color: var(--color-white);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1rem;
		padding: 1rem 2.25rem;
		border-radius: 99px;
		border: 1px solid var(--color-white);
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.btn-outline-white:hover {
		background-color: var(--color-white);
		color: var(--color-dark);
	}

	.btn-ghost-orange {
		display: inline-block;
		color: var(--color-primary);
		background-color: rgba(255, 77, 0, 0.1);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1rem;
		padding: 1rem 2.25rem;
		border-radius: 99px;
		border: 1px solid transparent;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.btn-ghost-orange:hover {
		background-color: var(--color-primary);
		color: var(--color-white);
	}

	.section-padding {
		padding: 6rem 3rem;
	}

	@media (max-width: 768px) {
		.section-padding {
			padding: 4rem 1.5rem;
		}
	}

	.tag-subtitle {
		font-family: var(--font-heading);
		color: var(--color-primary);
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		margin-bottom: 1rem;
		display: block;
	}

	/* Floating WhatsApp Button */
	.whatsapp-float {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		width: 60px;
		height: 60px;
		background-color: #25D366;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);
		z-index: 999;
		transition: transform 0.3s ease, box-shadow 0.3s ease, opacity 0.4s ease, visibility 0.4s ease;
		animation: whatsapp-pulse 2s infinite;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.whatsapp-float.visible {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	.whatsapp-float:hover {
		transform: scale(1.1);
		box-shadow: 0 6px 28px rgba(37, 211, 102, 0.6);
	}

	@keyframes whatsapp-pulse {
		0% { box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4); }
		50% { box-shadow: 0 4px 30px rgba(37, 211, 102, 0.6); }
		100% { box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4); }
	}

	@media (max-width: 768px) {
		.whatsapp-float {
			bottom: 1.25rem;
			right: 1.25rem;
			width: 54px;
			height: 54px;
		}
	}

	/* ── Back to Top Button ── */
	.back-to-top {
		position: fixed;
		bottom: 2rem;
		left: 2rem;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--color-dark);
		color: var(--color-white);
		border: 1px solid rgba(255,255,255,0.1);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		visibility: hidden;
		transform: translateY(10px);
		transition: opacity 0.3s ease, transform 0.3s ease, background 0.3s ease, visibility 0.3s ease;
		z-index: 998;
	}

	.back-to-top.visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.back-to-top:hover {
		background: var(--color-primary);
	}

	@media (max-width: 768px) {
		.back-to-top {
			bottom: 1.25rem;
			left: 1.25rem;
			width: 40px;
			height: 40px;
		}
	}

	/* ── Cookie Consent Banner ── */
	.cookie-banner {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		background: var(--color-dark);
		border-top: 1px solid rgba(255,255,255,0.1);
		padding: 1.25rem 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		z-index: 1000;
		transform: translateY(100%);
		transition: transform 0.4s ease;
	}

	.cookie-banner.visible {
		transform: translateY(0);
	}

	.cookie-text {
		color: #ccc;
		font-size: 0.9rem;
		line-height: 1.5;
		max-width: 600px;
	}

	.cookie-text a {
		color: var(--color-primary);
		text-decoration: underline;
	}

	.cookie-actions {
		display: flex;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.cookie-btn {
		font-family: var(--font-heading);
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.6rem 1.25rem;
		border-radius: 99px;
		border: none;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.cookie-accept {
		background: var(--color-primary);
		color: white;
	}

	.cookie-accept:hover {
		background: #e64400;
	}

	.cookie-reject {
		background: transparent;
		color: #999;
		border: 1px solid rgba(255,255,255,0.2);
	}

	.cookie-reject:hover {
		border-color: rgba(255,255,255,0.4);
		color: white;
	}

	@media (max-width: 768px) {
		.cookie-banner {
			flex-direction: column;
			padding: 1.25rem 1.5rem;
			gap: 1rem;
			text-align: center;
		}

		.cookie-actions {
			width: 100%;
			justify-content: center;
		}
	}

	/* ── Scroll Reveal Animations ── */
	.anim-fade-up,
	.anim-fade-in,
	.anim-slide-left,
	.anim-slide-right {
		opacity: 0;
		transition: opacity 0.7s ease, transform 0.7s ease;
		will-change: opacity, transform;
	}

	.anim-fade-up {
		transform: translateY(30px);
	}

	.anim-slide-left {
		transform: translateX(-40px);
	}

	.anim-slide-right {
		transform: translateX(40px);
	}

	.anim-fade-up.is-visible,
	.anim-fade-in.is-visible,
	.anim-slide-left.is-visible,
	.anim-slide-right.is-visible {
		opacity: 1;
		transform: translate(0);
	}

	/* Stagger delays for child elements */
	.anim-delay-1 { transition-delay: 0.1s; }
	.anim-delay-2 { transition-delay: 0.2s; }
	.anim-delay-3 { transition-delay: 0.3s; }
	.anim-delay-4 { transition-delay: 0.4s; }
	.anim-delay-5 { transition-delay: 0.5s; }
	.anim-delay-6 { transition-delay: 0.6s; }

	/* Respect prefers-reduced-motion */
	@media (prefers-reduced-motion: reduce) {
		.anim-fade-up,
		.anim-fade-in,
		.anim-slide-left,
		.anim-slide-right {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	/* ── Responsive foundation ── */
	@media (max-width: 900px) {
		body .hero-inner,
		body .services,
		body .section-padding {
			padding-left: clamp(1.25rem, 4vw, 2rem);
			padding-right: clamp(1.25rem, 4vw, 2rem);
		}

		body .hero {
			min-height: 100svh;
		}

		body .hero-content,
		body .hero-desc,
		body .services-header,
		body .process-header,
		body .faq-header,
		body .cta-inner {
			max-width: 100%;
		}

		body .plans-grid,
		body .testimonials-grid {
			width: 100%;
		}

		body .testimonial-card {
			min-width: 0;
			width: 100%;
		}

		body .cta-methods-list {
			width: 100%;
		}

		body .cta-method {
			flex: 1 1 220px;
