---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Button from '../../../components/ui/Button.astro';
import { Component as InteractiveGlobe } from '../../../components/ui/interactive-globe';
---

<Layout title="KAIROS Digital | Digital solutions for business" description="KAIROS Digital turns business needs into functional websites, platforms, automations, and digital tools." schemaType="Service">
  <Header />
  <main>
    <section class="digital-hero section-padding"><div class="digital-wrap digital-hero-grid"><div><span class="digital-eyebrow anim-fade-up">KAIROS DIGITAL · DESIGN · DEVELOPMENT</span><h1 class="digital-hero-title anim-fade-up anim-delay-1">We build the digital layer of your business.</h1><p class="digital-hero-desc anim-fade-up anim-delay-2">We turn business needs into functional digital solutions. Technology to solve real problems, not to add complexity.</p><div class="digital-actions anim-fade-up anim-delay-3"><Button href="https://api.whatsapp.com/send?phone=573133024941&amp;text=Hi%20Kairos%2C%20I%27m%20interested%20in%20a%20digital%20project." external variant="primary">Let's build your solution</Button><a class="digital-text-link" href="#offer"><span>↓</span> See what we build</a></div></div><div class="digital-globe-stage anim-fade-in anim-delay-2"><div class="globe-stage-top"><span>PROJECT / DIGITAL</span><span><i></i> IN DEVELOPMENT</span></div><div class="globe-stage-planet"><InteractiveGlobe client:load size={470} /></div><div class="globe-stage-foot"><span>IDENTITY · TECHNOLOGY · IMPACT</span><strong>100%</strong></div></div></div></section>

    <section class="digital-offer section-padding" id="offer"><div class="digital-wrap"><div class="digital-section-head"><div><span class="digital-kicker anim-fade-up">WHAT WE BUILD</span><h2 class="digital-title anim-fade-up anim-delay-1">Digital solutions that move the business forward.</h2></div><p class="digital-intro anim-fade-up anim-delay-2">Every project starts with a concrete need and ends in a functional, clear tool aligned with the way you work.</p></div><div class="offer-list anim-fade-up anim-delay-3"><div class="offer-row"><span>01</span><div><h3>Corporate website</h3><p>A digital presence with identity, purpose, and a clear route for visitors.</p></div><b>↗</b></div><div class="offer-row"><span>02</span><div><h3>Landing page</h3><p>An experience focused on turning a concrete proposition into action.</p></div><b>↗</b></div><div class="offer-row"><span>03</span><div><h3>Custom platform</h3><p>Applications, portals, and tools designed around your operations.</p></div><b>↗</b></div><div class="offer-row"><span>04</span><div><h3>Automation and integrations</h3><p>We connect systems and reduce repetitive tasks to free up capacity.</p></div><b>↗</b></div><div class="offer-row"><span>05</span><div><h3>Digital tools</h3><p>We build specific solutions when a generic tool is not enough.</p></div><b>↗</b></div></div></div></section>

    <section class="digital-approach section-padding"><div class="digital-wrap"><span class="digital-kicker anim-fade-up">OUR APPROACH</span><div class="digital-section-head"><h2 class="digital-title digital-title-dark anim-fade-up anim-delay-1">Identity first. Technology second.</h2><p class="digital-intro digital-intro-dark anim-fade-up anim-delay-2">We do not start with design or code. We start by understanding what you need to solve, communicate, and make possible.</p></div><div class="digital-principles anim-fade-up anim-delay-3"><div class="digital-principle"><span>01</span><h3>Direction before interface</h3><p>We define what the solution must do and who it is for before building it.</p></div><div class="digital-principle"><span>02</span><h3>Function before noise</h3><p>Every technology decision has a purpose and a direct relationship with the business.</p></div><div class="digital-principle"><span>03</span><h3>Support after launch</h3><p>We measure, iterate, and stay close so the solution remains useful.</p></div></div></div></section>

    <section class="digital-process section-padding" id="process"><div class="digital-wrap"><div class="digital-section-head"><div><span class="digital-kicker anim-fade-up">HOW WE WORK</span><h2 class="digital-title anim-fade-up anim-delay-1">From need to a solution that works.</h2></div><p class="digital-intro anim-fade-up anim-delay-2">Technology moves through clear stages, with shared decisions and support through launch and beyond.</p></div><div class="digital-timeline anim-fade-up anim-delay-3"><div><span>01</span><h3>Understand</h3><p>Context, objectives, and the real problem.</p></div><div><span>02</span><h3>Design</h3><p>Architecture, experience, and direction.</p></div><div><span>03</span><h3>Develop</h3><p>Focused construction with criteria.</p></div><div><span>04</span><h3>Test</h3><p>Validation before putting it to work.</p></div><div><span>05</span><h3>Launch</h3><p>A clear and prepared release.</p></div><div><span>06</span><h3>Support</h3><p>Iteration, care, and impact.</p></div></div></div></section>

    <section class="digital-cta section-padding"><div class="digital-wrap digital-cta-inner anim-fade-up"><span class="digital-kicker">DIGITAL PROJECTS</span><h2 class="digital-cta-title">Let's build the solution your business needs.</h2><p class="digital-cta-desc">Tell us what you need. We understand the challenge, propose a direction, and if it makes sense, build together.</p><Button href="https://api.whatsapp.com/send?phone=573133024941&amp;text=Hi%20Kairos%2C%20I%27m%20interested%20in%20a%20digital%20project." external variant="primary">Let's build your solution</Button></div></section>
  </main>
  <Footer />
</Layout>

<style>
  :global(.header){background-color:var(--color-white)}:global(.header .nav-links a){color:rgba(10,10,10,.72)}:global(.header .nav-links a:hover){color:var(--color-dark)}:global(.header .lang-text){color:rgba(10,10,10,.48)!important}:global(.header .lang-divider){color:rgba(10,10,10,.2)!important}:global(.header .menu-toggle span){background-color:rgba(10,10,10,.7)}
  .digital-wrap{max-width:1120px;margin:0 auto;padding:0 1.5rem}.digital-eyebrow,.digital-kicker{display:block;color:var(--color-primary);font-family:var(--font-heading);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:1.35rem}.digital-title{max-width:20ch;color:var(--color-white);font-family:'Bricolage Grotesque',var(--font-heading),system-ui,sans-serif;font-size:clamp(2rem,4.2vw,3.25rem);font-weight:800;line-height:1.02;letter-spacing:-.03em}.digital-title-dark{color:var(--color-dark)}.digital-intro{max-width:43ch;color:#999;font-size:1.05rem;line-height:1.65}.digital-intro-dark{color:var(--color-gray)}
  .digital-hero{background:var(--color-white);min-height:78vh;display:flex;align-items:center;overflow:hidden}.digital-hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.digital-hero-title{max-width:11ch;color:var(--color-dark);font-family:'Bricolage Grotesque',var(--font-heading),system-ui,sans-serif;font-size:clamp(3rem,6.5vw,5.2rem);font-weight:800;line-height:.96;letter-spacing:-.05em}.digital-hero-desc{max-width:48ch;color:var(--color-gray);font-size:1.1rem;line-height:1.65;margin:1.75rem 0 2.25rem}.digital-actions{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}.digital-text-link{color:var(--color-gray);font-size:.9rem}.digital-text-link span{color:var(--color-primary);margin-right:.45rem;font-size:1.15rem}.digital-system{position:relative;min-height:430px;padding:1.25rem;background:var(--color-dark);border-radius:4px;box-shadow:0 24px 60px rgba(10,10,10,.18)}.system-top,.system-foot{display:flex;justify-content:space-between;color:#888;font-family:var(--font-heading);font-size:.62rem;letter-spacing:.12em}.system-status{color:var(--color-primary)}.system-status i{display:inline-block;width:6px;height:6px;margin-right:5px;border-radius:50%;background:var(--color-primary);animation:digitalPulse 1.8s ease-in-out infinite}.system-grid{position:relative;min-height:330px;margin-top:.75rem;overflow:hidden;background:radial-gradient(circle at center,rgba(255,77,0,.16),transparent 34%),linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:auto,42px 42px,42px 42px}.system-orbit{position:absolute;top:50%;left:50%;border:1px solid rgba(255,77,0,.32);border-radius:50%;transform:translate(-50%,-50%) rotate(-20deg)}.orbit-a{width:72%;height:42%}.orbit-b{width:48%;height:70%;transform:translate(-50%,-50%) rotate(65deg);border-color:rgba(255,255,255,.15)}.system-core{position:absolute;top:50%;left:50%;display:grid;place-items:center;width:132px;height:132px;transform:translate(-50%,-50%);border:1px solid var(--color-primary);border-radius:50%;background:var(--color-dark);color:var(--color-white)}.system-core small{color:var(--color-primary);font-size:.62rem;letter-spacing:.16em}.system-core strong{font-family:var(--font-heading);font-size:1.15rem}.system-core span{color:#777;font-size:.55rem;letter-spacing:.08em}.system-node{position:absolute;color:#aaa;font-family:var(--font-heading);font-size:.62rem;letter-spacing:.09em}.node-a{top:18%;left:8%}.node-b{top:12%;right:8%}.node-c{bottom:15%;left:9%}.node-d{right:8%;bottom:13%}.system-foot{position:absolute;right:1.25rem;bottom:1.25rem;left:1.25rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.12)}.system-foot strong{color:var(--color-primary);font-size:1rem}@keyframes digitalPulse{50%{opacity:.35;transform:scale(.7)}}
  .digital-system{background:var(--color-light);border:1px solid rgba(10,10,10,.14);box-shadow:0 24px 60px rgba(10,10,10,.12)}.digital-system .system-top,.digital-system .system-foot{color:rgba(10,10,10,.56)}.digital-system .system-grid{background:radial-gradient(circle at center,rgba(255,77,0,.13),transparent 34%),linear-gradient(rgba(10,10,10,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(10,10,10,.055) 1px,transparent 1px);background-size:auto,42px 42px,42px 42px}.system-grid:after{content:'';position:absolute;top:0;left:0;width:100%;height:1px;background:var(--color-primary);opacity:.5;animation:digitalScan 5s ease-in-out infinite}.digital-system .system-orbit{border-color:rgba(10,10,10,.2)}.digital-system .orbit-a{border-color:rgba(255,77,0,.48);animation:digitalOrbitA 12s linear infinite}.digital-system .orbit-b{border-color:rgba(10,10,10,.18);animation:digitalOrbitB 16s linear infinite}.digital-system .system-core{background:var(--color-white);color:var(--color-dark);box-shadow:0 0 0 12px rgba(255,77,0,.06);animation:digitalCore 3.2s ease-in-out infinite}.digital-system .system-core span{color:rgba(10,10,10,.54)}.digital-system .system-node{color:rgba(10,10,10,.62);animation:digitalNode 8s ease-in-out infinite}.digital-system .node-a{animation-delay:0s}.digital-system .node-b{animation-delay:2s}.digital-system .node-c{animation-delay:4s}.digital-system .node-d{animation-delay:6s}.digital-system .system-foot{border-top-color:rgba(10,10,10,.14)}@keyframes digitalScan{0%,100%{top:0;opacity:0}15%,85%{opacity:.55}50%{top:100%;opacity:.18}}@keyframes digitalOrbitA{from{transform:translate(-50%,-50%) rotate(-20deg)}to{transform:translate(-50%,-50%) rotate(340deg)}}@keyframes digitalOrbitB{from{transform:translate(-50%,-50%) rotate(65deg)}to{transform:translate(-50%,-50%) rotate(-295deg)}}@keyframes digitalCore{50%{box-shadow:0 0 0 20px rgba(255,77,0,.03);transform:translate(-50%,-50%) scale(1.025)}}@keyframes digitalNode{0%,100%{color:rgba(10,10,10,.48);opacity:.72}12%,25%{color:var(--color-primary);opacity:1}37%{color:rgba(10,10,10,.62);opacity:.72}}@media(prefers-reduced-motion:reduce){.system-grid:after,.system-orbit,.system-core,.system-node,.system-status i{animation:none}.system-grid:after{display:none}}
  .digital-offer,.digital-process{background:var(--color-dark);border-bottom:1px solid rgba(255,255,255,.08)}.digital-section-head{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:end}.offer-list{margin-top:3.5rem;border-top:1px solid rgba(255,255,255,.15)}.offer-row{display:grid;grid-template-columns:52px 1fr 30px;gap:1rem;align-items:center;padding:1.3rem 0;border-bottom:1px solid rgba(255,255,255,.15)}.offer-row>span{color:var(--color-primary);font-family:var(--font-heading);font-size:.72rem}.offer-row h3{color:var(--color-white);font-size:1.35rem;margin-bottom:.35rem}.offer-row p{color:#999;font-size:.92rem;line-height:1.5}.offer-row b{color:var(--color-primary);font-size:1.15rem;text-align:right}
  .digital-approach{background:var(--color-white);border-bottom:1px solid var(--color-gray-light)}.digital-approach .digital-section-head{margin-top:.5rem}.digital-principles{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3.5rem}.digital-principle{padding-top:1.25rem;border-top:2px solid var(--color-primary)}.digital-principle>span{color:var(--color-primary);font-family:var(--font-heading);font-size:.72rem;letter-spacing:.12em}.digital-principle h3{margin:1rem 0 .55rem;color:var(--color-dark);font-size:1.2rem}.digital-principle p{color:var(--color-gray);font-size:.92rem;line-height:1.55}
  .digital-process .digital-title{max-width:18ch}.digital-timeline{position:relative;display:grid;grid-template-columns:repeat(6,1fr);gap:1rem;margin-top:3.5rem;border-top:1px solid rgba(255,255,255,.28)}.digital-timeline>div{position:relative;padding-top:2rem}.digital-timeline>div:before{content:'';position:absolute;top:-5px;left:0;width:9px;height:9px;border-radius:50%;background:var(--color-primary);box-shadow:0 0 0 6px var(--color-dark)}.digital-timeline span{color:var(--color-primary);font-family:var(--font-heading);font-size:.72rem;letter-spacing:.12em}.digital-timeline h3{margin:1rem 0 .55rem;color:var(--color-white);font-size:1.05rem}.digital-timeline p{max-width:17ch;color:#888;font-size:.82rem;line-height:1.5}
  .digital-cta{background:var(--color-white);text-align:center}.digital-cta-inner{display:flex;flex-direction:column;align-items:center}.digital-cta-title{max-width:18ch;color:var(--color-dark);font-family:'Bricolage Grotesque',var(--font-heading),system-ui,sans-serif;font-size:clamp(2.2rem,4.5vw,3.6rem);font-weight:800;line-height:1;letter-spacing:-.035em}.digital-cta-desc{max-width:48ch;margin:1.5rem 0 2rem;color:var(--color-gray);font-size:1.05rem;line-height:1.6}
  @media(max-width:860px){.digital-hero-grid,.digital-section-head{grid-template-columns:1fr;gap:2rem}.digital-hero{min-height:auto}.digital-system{min-height:390px}.digital-principles{grid-template-columns:1fr;gap:2rem}.digital-timeline{grid-template-columns:repeat(3,1fr);row-gap:2.5rem}}
  @media(max-width:580px){.digital-wrap{padding:0 1.25rem}.digital-hero-title{font-size:clamp(2.8rem,14vw,4.2rem)}.digital-actions{align-items:flex-start;flex-direction:column;gap:1rem}.digital-system{min-height:390px}.system-grid{min-height:300px}.system-core{width:112px;height:112px}.system-node{font-size:.52rem}.digital-timeline{grid-template-columns:repeat(2,1fr);gap:2rem}.offer-row{grid-template-columns:36px 1fr 22px}.offer-row p{font-size:.84rem}}
  .digital-globe-stage{position:relative;min-height:430px;padding:1.25rem;background:var(--color-light);border:1px solid rgba(10,10,10,.14);border-radius:4px;box-shadow:0 24px 60px rgba(10,10,10,.12);overflow:hidden}.globe-stage-top,.globe-stage-foot{position:relative;z-index:2;display:flex;justify-content:space-between;color:rgba(10,10,10,.56);font-family:var(--font-heading);font-size:.62rem;letter-spacing:.12em}.globe-stage-top span:last-child{color:var(--color-primary)}.globe-stage-top i{display:inline-block;width:6px;height:6px;margin-right:5px;border-radius:50%;background:var(--color-primary);animation:digitalPulse 1.8s ease-in-out infinite}.globe-stage-planet{display:grid;place-items:center;min-height:350px;margin:-.2rem 0}.interactive-globe-canvas{display:block;max-width:100%;height:auto;touch-action:none;cursor:grab}.interactive-globe-canvas:active{cursor:grabbing}.globe-stage-foot{position:absolute;right:1.25rem;bottom:1.25rem;left:1.25rem;padding-top:1rem;border-top:1px solid rgba(10,10,10,.14)}.globe-stage-foot strong{color:var(--color-primary);font-size:1rem}@media(prefers-reduced-motion:reduce){.globe-stage-top i{animation:none}}
</style>
