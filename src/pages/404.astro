---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout title="Página no encontrada | Kαiros" description="La página que buscas no existe.">
	<Header />
	<main class="not-found section-padding">
		<div class="not-found-inner">
			<span class="not-found-code">404</span>
			<h1 class="not-found-title">Esta página no existe.</h1>
			<p class="not-found-text">Puede que la URL haya cambiado o que la página ya no esté disponible.</p>
			<div class="not-found-actions">
				<a href="/" class="btn-primary">Volver al inicio</a>
				<a href="/#servicios" class="btn-outline">Ver servicios</a>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.not-found {
		background-color: var(--color-dark);
		min-height: 70vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.not-found-inner {
		text-align: center;
		max-width: 600px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.not-found-code {
		font-family: var(--font-heading);
		font-size: clamp(5rem, 12vw, 8rem);
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1;
		opacity: 0.3;
	}

	.not-found-title {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		color: var(--color-white);
		line-height: 1.2;
	}

	.not-found-text {
		font-size: 1.125rem;
		color: #999;
		line-height: 1.6;
	}

	.not-found-actions {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
		flex-wrap: wrap;
		justify-content: center;
	}
</style>
