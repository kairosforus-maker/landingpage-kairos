---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Button from '../../components/ui/Button.astro';
---

<Layout title="KAIROS Academy | Talleres, capacitación y masterclasses" description="Formación a la medida para empresas, universidades y colegios: talleres, capacitaciones y masterclasses en liderazgo, posicionamiento, inteligencia artificial y estrategia.">
  <Header />
  <main class="academy-page">
    <section class="academy-hero section-padding">
      <div class="academy-wrap academy-hero-grid">
        <div>
          <span class="academy-kicker anim-fade-up">KAIROS ACADEMY · CONOCIMIENTO · CAPACIDADES</span>
          <h1 class="academy-hero-title anim-fade-up anim-delay-1">El conocimiento que no se aplica, se olvida.</h1>
          <p class="academy-hero-copy anim-fade-up anim-delay-2">Diseñamos talleres, capacitaciones y masterclasses a la medida de tu organización, a partir de las oportunidades reales que detectamos para afianzar conocimiento en tus equipos.</p>
          <div class="academy-actions anim-fade-up anim-delay-3">
            <Button href="https://api.whatsapp.com/send?phone=573133024941&text=Hola%20Kairos%2C%20quiero%20conocer%20Kairos%20Academy%20para%20mi%20organizaci%C3%B3n." external variant="primary">Diseñemos tu plan Academy</Button>
            <a class="academy-link" href="#experiencia"><span>↓</span> Ver dónde hemos enseñado</a>
          </div>
        </div>
        <div class="academy-hero-visual">
        <div class="academy-hero-card anim-fade-in anim-delay-2" aria-label="Kairos Academy: aprender, aplicar, construir y medir">
          <div class="academy-card-top"><span>ACADEMY / KAIROS</span><span class="academy-live"><i></i> EN ACCIÓN</span></div>
          <div class="academy-card-center"><strong class="academy-step is-active">APRENDER</strong><span>↓</span><strong class="academy-step">APLICAR</strong><span>↓</span><strong class="academy-step">CONSTRUIR</strong><span>↓</span><strong class="academy-step">MEDIR</strong><div class="academy-card-progress" aria-hidden="true"><i></i></div></div>
          <div class="academy-card-foot"><span>CONOCIMIENTO QUE SE QUEDA</span><b>100%</b></div>
        </div>
        <div class="academy-stats anim-fade-up anim-delay-3"><div><strong>3</strong><span>formatos</span></div><div><strong>3</strong><span>países donde hemos enseñado</span></div><div><strong>100%</strong><span>a la medida</span></div></div>
        </div>
      </div>
    </section>

    <section class="academy-when section-padding">
      <div class="academy-wrap">
        <div class="academy-section-head"><div><span class="academy-kicker">CUÁNDO TIENE SENTIDO</span><h2>Cuando tu equipo tiene las herramientas, pero no la confianza para usarlas.</h2></div><p>La formación funciona cuando responde a un reto concreto y puede aplicarse al día siguiente.</p></div>
        <div class="academy-signal-grid"><p>Adoptaron herramientas nuevas y el uso sigue siendo tímido o desigual.</p><p>Detectaste una brecha de conocimiento que está frenando procesos o resultados.</p><p>Tus líderes y profesionales necesitan fortalecer su reputación y presencia digital.</p><p>Quieres formación que se aplique al día siguiente, no una charla más.</p></div>
      </div>
    </section>

    <section class="academy-formats section-padding">
      <div class="academy-wrap"><span class="academy-kicker">QUÉ HACEMOS</span><div class="academy-section-head"><h2>Tres formatos. Una misma intención: que lo aprendido se quede.</h2><p>El contenido cambia según tu reto, pero siempre conectamos aprendizaje con acción.</p></div>
        <div class="academy-format-grid"><article><span>01</span><h3>Masterclass</h3><p>Una sesión de alto impacto para abrir conversación e inspirar a grupos amplios.</p><small>Ideal para eventos, comunidades y auditorios.</small></article><article><span>02</span><h3>Taller</h3><p>Práctica guiada en grupos reducidos. Cada participante sale con algo construido.</p><small>Ideal para equipos y áreas.</small></article><article><span>03</span><h3>Capacitación</h3><p>Un programa de varias sesiones con objetivos de aprendizaje, seguimiento y medición.</p><small>Ideal para procesos de cambio y desarrollo de capacidades.</small></article></div>
        <div class="academy-topics"><h3>Áreas de conocimiento</h3><div class="academy-topic-groups"><article><span class="academy-topic-index">01</span><span class="academy-topic-label">NEGOCIO Y GESTIÓN</span><div><span>Emprendimiento</span><span>Marketing</span><span>Negocio digital</span></div></article><article><span class="academy-topic-index">02</span><span class="academy-topic-label">TECNOLOGÍA Y DATOS</span><div><span>IA aplicada</span><span>Big Data y Analytics</span><span>Metodologías ágiles</span></div></article><article><span class="academy-topic-index">03</span><span class="academy-topic-label">PERSONAS Y DESARROLLO</span><div><span>Reputación digital y LinkedIn</span><span>Liderazgo y desempeño</span></div></article></div></div>
      </div>
    </section>

    <section class="academy-experience section-padding" id="experiencia"><div class="academy-wrap"><span class="academy-kicker">KAIROS ACADEMY EN ACCIÓN</span><h2>Formaciones que ya hemos dictado.</h2><div class="academy-experience-grid"><article class="academy-experience-card"><div class="academy-experience-photo"><img src="/images/academy/queretaro-reputacion-optimizada.webp" alt="Masterclass de reputación digital en Querétaro" loading="lazy"/><img class="academy-institution-logo" src="/images/academy/logo-queretaro.webp" alt="Universidad Autónoma de Querétaro" loading="lazy"/></div><div class="academy-experience-copy"><span>MASTERCLASS · NOV 2026</span><h3>Reputación Digital Profesional</h3><p>Universidad Autónoma de Querétaro · México.</p><small>Estrategias prácticas para conectar en LinkedIn.</small></div></article><article class="academy-experience-card"><div class="academy-experience-photo"><img src="/images/academy/reputacion-uninorte.webp" alt="Masterclass de reputación digital en Uninorte" loading="lazy"/><img class="academy-institution-logo" src="/images/academy/logo-uninorte.webp" alt="Universidad del Norte" loading="lazy"/></div><div class="academy-experience-copy"><span>MASTERCLASS · SEP 2026</span><h3>Reputación Digital Profesional</h3><p>Universidad del Norte · Centro de Emprendimiento.</p><small>Lo que vales, que se note.</small></div></article><article class="academy-experience-card"><div class="academy-experience-photo"><img src="/images/academy/reputacion-americana.webp" alt="Masterclass de reputación digital en la Corporación Universitaria Americana" loading="lazy"/><img class="academy-institution-logo" src="/images/academy/logo-americana.webp" alt="Corporación Universitaria Americana" loading="lazy"/></div><div class="academy-experience-copy"><span>MASTERCLASS · SEP 2026</span><h3>Reputación Digital Profesional</h3><p>Corporación Universitaria Americana.</p><small>Lo que vales, que se note.</small></div></article><article class="academy-experience-card"><div class="academy-experience-photo"><img src="/images/academy/ia-mayores.webp" alt="Taller de inteligencia artificial para personas mayores de 50" loading="lazy"/><img class="academy-institution-logo" src="/images/academy/logo-americana.webp" alt="Corporación Universitaria Americana" loading="lazy"/></div><div class="academy-experience-copy"><span>MASTERCLASS · SEP 2026</span><h3>Economía Silver: IA para mayores de 50</h3><p>Corporación Universitaria Americana · WOW Work.</p><small>Habilidades digitales e IA para personas 50+.</small></div></article><article class="academy-experience-card"><div class="academy-experience-photo"><img src="/images/academy/coaching-saber-pro-nuevo.webp" alt="Sesión de coaching para preparación de las pruebas Saber Pro en el Nuevo Colegio del Prado" loading="lazy"/><img class="academy-institution-logo" src="/images/academy/logo-neoprado.webp" alt="Nuevo Colegio del Prado" loading="lazy"/></div><div class="academy-experience-copy"><span>TALLER · JUL 2026</span><h3>Coaching para pruebas Saber Pro</h3><p>Nuevo Colegio del Prado.</p><small>Preparación y enfoque para estudiantes de último año.</small></div></article><article class="academy-next"><span>PRÓXIMA</span><h3>¿Tu organización?</h3><p>Diseñamos la formación a partir de lo que tu equipo necesita.</p><a href="#contacto">Agenda la visita →</a></article></div></div></section>

    <section class="academy-leader section-padding"><div class="academy-wrap academy-leader-grid"><div class="academy-leader-photo"><img src="/foto_alberto.png" alt="Alberto Mario Guzmán, líder de Kairos Academy" /></div><div><span class="academy-kicker">QUIÉN LIDERA</span><h2>Experiencia en el aula, en la empresa y en lo digital.</h2><h3>Alberto Mario Guzmán</h3><p class="academy-leader-role">Líder de Kairos Academy</p><p>Docente universitario en Colombia y España, con masterclass también en México. Une la mirada académica con la práctica de construir marcas, equipos y herramientas digitales con Kairos.</p><div class="academy-credentials"><div><span>FORMACIÓN</span><p>MBA · Universidad Sergio Arboleda<br />Executive MBA · Universitat Politècnica de València<br />Master in Digital Business · Universidad Rey Juan Carlos</p></div><div><span>DOCENCIA</span><p>Big Data y Analytics · Metodologías Ágiles · Emprendimiento · Business Startup Marketing · Sistemas de Información</p></div></div></div></div></section>

    <section class="academy-method section-padding"><div class="academy-wrap"><div class="academy-section-head"><div><span class="academy-kicker">CÓMO FUNCIONA</span><h2>Primero entendemos tu organización. Después diseñamos lo que necesita aprender.</h2></div><p>No llegamos con un curso de catálogo. Escuchamos a líderes y equipos y construimos un plan Academy a la medida.</p></div><div class="academy-process"><div><span>01 · VISITAMOS</span><h3>Diagnóstico en sitio</h3><p>Conversaciones con líderes, observación de procesos y una encuesta corta a los equipos.</p></div><div><span>02 · DETECTAMOS</span><h3>Mapa de oportunidades</h3><p>Identificamos qué conocimiento falta, dónde frena resultados y qué tiene más impacto.</p></div><div><span>03 · DISEÑAMOS</span><h3>Plan Academy a la medida</h3><p>Formatos, temas, grupos, calendario e indicadores de aprendizaje.</p></div><div><span>04 · ENSEÑAMOS Y MEDIMOS</span><h3>Ejecución y seguimiento</h3><p>Dictamos las sesiones y medimos qué se aplicó y qué cambió.</p></div></div><div class="academy-receives"><h3>Qué recibe tu organización</h3><div><p>Informe de diagnóstico con las brechas detectadas.</p><p>Plan Academy con formatos, temas y calendario.</p><p>Materiales digitales para cada sesión.</p><p>Cierre con indicadores y recomendaciones para seguir construyendo.</p></div></div></div></section>

    <section class="academy-faq section-padding"><div class="academy-wrap"><span class="academy-kicker">PREGUNTAS FRECUENTES</span><h2>Antes de empezar.</h2><div class="academy-faq-list"><details><summary>¿Cuánto cuesta un plan Academy?</summary><p>Cada plan es a la medida y se cotiza después del diagnóstico, según formatos, número de sesiones y participantes. La primera conversación es gratuita y sin compromiso.</p></details><details><summary>¿Las sesiones son presenciales o virtuales?</summary><p>Ambas. Presenciales si hay cercanía, o por videollamada, según lo que funcione mejor para tu equipo.</p></details><details><summary>¿Pueden adaptar una formación que ya dictaron?</summary><p>Sí. Cada masterclass o taller se ajusta al sector, al nivel y a los objetivos del grupo.</p></details><details><summary>¿Trabajan con colegios y universidades?</summary><p>Sí. Hemos dictado formaciones para universidades, colegios y centros de empleabilidad en Colombia y México.</p></details></div></div></section>

    <section class="academy-cta section-padding" id="contacto"><div class="academy-wrap academy-cta-inner"><span class="academy-kicker">KAIROS ACADEMY</span><h2>¿Qué necesita aprender tu equipo para avanzar?</h2><p>Agenda una visita y construyamos juntos tu plan Academy.</p><div class="academy-cta-actions"><Button href="https://cal.com/kairos4us/30min" external variant="primary">Agenda la visita diagnóstica</Button><a class="academy-whatsapp-link" href="https://api.whatsapp.com/send?phone=573133024941&text=Hola%20Kairos%2C%20quiero%20conocer%20Kairos%20Academy%20para%20mi%20organizaci%C3%B3n." target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a></div></div></section>
  </main>
  <Footer />
</Layout>

<style>
  :global(.header){background:var(--color-white)}:global(.header .nav-links a){color:rgba(10,10,10,.72)}:global(.header .nav-links a:hover){color:var(--color-dark)}:global(.header .lang-text){color:rgba(10,10,10,.48)!important}:global(.header .lang-divider){color:rgba(10,10,10,.2)!important}:global(.header .menu-toggle span){background-color:rgba(10,10,10,.7)}
  .academy-page{background:var(--color-white);color:var(--color-dark)}.academy-wrap{max-width:1120px;margin:0 auto;padding:0 1.5rem}.academy-kicker{display:block;color:var(--color-primary);font-family:var(--font-heading);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:1.3rem}.academy-hero{min-height:78vh;display:flex;align-items:center}.academy-hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.academy-hero-title,.academy-section-head h2,.academy-formats h2,.academy-experience h2,.academy-cta h2{font-family:'Bricolage Grotesque',var(--font-heading),system-ui,sans-serif;font-weight:800;letter-spacing:-.04em;line-height:1}.academy-hero-title{max-width:10ch;font-size:clamp(3rem,6vw,5.2rem)}.academy-hero-copy{max-width:48ch;color:var(--color-gray);font-size:1.08rem;line-height:1.65;margin:1.8rem 0 2.2rem}.academy-actions{display:flex;gap:1.4rem;align-items:center;flex-wrap:wrap}.academy-link{color:var(--color-gray);font-size:.9rem}.academy-link span{color:var(--color-primary);font-size:1.2rem;margin-right:.4rem}.academy-hero-card{min-height:470px;padding:1.3rem;background:#0a0a0a;color:#fff;border-radius:4px;box-shadow:0 24px 60px rgba(10,10,10,.16);display:flex;flex-direction:column}.academy-card-top,.academy-card-foot{display:flex;justify-content:space-between;font-family:var(--font-heading);font-size:.62rem;letter-spacing:.13em;color:#999}.academy-live{color:var(--color-primary)}.academy-live i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--color-primary);margin-right:.4rem;animation:academyPulse 1.8s ease-in-out infinite}.academy-card-center{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:.7rem;font-family:var(--font-heading);font-size:clamp(1.5rem,3vw,2.5rem);letter-spacing:-.04em}.academy-card-center strong{opacity:.38;animation:academyStep 8s ease-in-out infinite}.academy-card-center strong:nth-of-type(2){animation-delay:-2s}.academy-card-center strong:nth-of-type(3){animation-delay:-4s}.academy-card-center strong:nth-of-type(4){animation-delay:-6s}.academy-card-center span{color:#666;font-size:1.3rem;animation:academyArrow 8s ease-in-out infinite}.academy-card-center span:nth-of-type(2){animation-delay:-2s}.academy-card-center span:nth-of-type(3){animation-delay:-4s}.academy-card-center span:nth-of-type(4){animation-delay:-6s}.academy-card-progress{width:min(13rem,70%);height:2px;margin-top:.7rem;background:rgba(255,255,255,.16);overflow:hidden}.academy-card-progress i{display:block;width:25%;height:100%;background:var(--color-primary);transform-origin:left;animation:academyProgress 8s linear infinite}.academy-card-foot{padding-top:1rem;border-top:1px solid rgba(255,255,255,.18)}.academy-card-foot b{color:var(--color-primary);font-size:1rem}.academy-when,.academy-method{background:#0a0a0a;color:#fff}.academy-section-head{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:end}.academy-section-head h2,.academy-formats h2,.academy-experience h2{max-width:18ch;font-size:clamp(2rem,4vw,3.4rem)}.academy-section-head>p,.academy-format-grid p,.academy-experience p,.academy-process p{color:#999;line-height:1.65}.academy-signal-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0 4rem;margin-top:4rem;border-top:1px solid rgba(255,255,255,.16)}.academy-signal-grid p{padding:1.3rem 0;border-bottom:1px solid rgba(255,255,255,.16);color:#bbb;line-height:1.5}.academy-formats{background:#fafafa}.academy-formats h2{color:var(--color-dark)}.academy-formats .academy-section-head{margin-bottom:3.3rem}.academy-format-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #e3e3e3}.academy-format-grid article{padding:2rem 2rem 2rem 0;border-right:1px solid #e3e3e3}.academy-format-grid article+article{padding-left:2rem}.academy-format-grid article:last-child{border-right:0}.academy-format-grid span,.academy-experience article>span,.academy-process>div>span{color:var(--color-primary);font-family:var(--font-heading);font-size:.7rem;letter-spacing:.14em}.academy-format-grid h3,.academy-experience h3,.academy-process h3{font-size:1.35rem;margin:.9rem 0 .5rem}.academy-format-grid small{color:#777;line-height:1.5}.academy-topics{margin-top:4rem;padding-top:2rem;border-top:1px solid #e3e3e3}.academy-topics h3{font-size:1.1rem;margin-bottom:1.2rem}.academy-topics div{display:flex;flex-wrap:wrap;gap:.6rem}.academy-topics span{padding:.65rem .85rem;border:1px solid #ddd;border-radius:999px;color:#555;font-size:.82rem}.academy-experience{background:#fff}.academy-experience h2{margin-bottom:3rem}.academy-experience-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #e3e3e3}.academy-experience article{padding:1.5rem 1.2rem 0 0;border-right:1px solid #e3e3e3}.academy-experience article+article{padding-left:1.2rem}.academy-experience article:last-child{border:0}.academy-experience h3{font-size:1.1rem}.academy-next{background:#fff1eb}.academy-next a{color:var(--color-primary);font-family:var(--font-heading);font-size:.85rem;font-weight:700}.academy-method{border-top:1px solid rgba(255,255,255,.08)}.academy-process{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-top:3.5rem;border-top:1px solid rgba(255,255,255,.25)}.academy-process>div{padding-top:1.6rem}.academy-process h3{color:#fff;font-size:1.15rem}.academy-cta{text-align:center;background:#fafafa}.academy-cta-inner{display:flex;align-items:center;flex-direction:column}.academy-cta h2{max-width:16ch;font-size:clamp(2.3rem,5vw,4rem)}.academy-cta p{color:var(--color-gray);margin:1.5rem 0 2rem}@keyframes academyPulse{50%{opacity:.35;transform:scale(.7)}}@keyframes academyStep{0%,20%{opacity:1;color:var(--color-primary);transform:scale(1.08)}20.01%,100%{opacity:.38;color:#fff;transform:scale(1)}}@keyframes academyArrow{0%,20%{color:var(--color-primary);opacity:1}20.01%,100%{color:#666;opacity:.45}}@keyframes academyProgress{0%{transform:translateX(-100%)}100%{transform:translateX(400%)}}
  @media (prefers-reduced-motion:reduce){.academy-card-center strong,.academy-card-center span,.academy-card-progress i,.academy-live i{animation:none}.academy-card-center strong:first-child{opacity:1;color:var(--color-primary);transform:scale(1.08)}}
  @media(max-width:860px){.academy-hero-grid,.academy-section-head{grid-template-columns:1fr;gap:2.2rem}.academy-hero{min-height:auto}.academy-hero-card{min-height:380px}.academy-format-grid{grid-template-columns:1fr}.academy-format-grid article,.academy-format-grid article+article{padding:1.5rem 0;border-right:0;border-bottom:1px solid #e3e3e3}.academy-experience-grid{grid-template-columns:repeat(2,1fr)}.academy-experience article:nth-child(2){border-right:0}.academy-experience article:nth-child(3){padding-left:0}.academy-process{grid-template-columns:repeat(2,1fr);row-gap:2.5rem}}
  @media(max-width:580px){.academy-wrap{padding:0 1.25rem}.academy-hero-title{font-size:clamp(2.8rem,14vw,4rem)}.academy-actions{align-items:flex-start;flex-direction:column}.academy-signal-grid,.academy-experience-grid,.academy-process{grid-template-columns:1fr}.academy-experience article,.academy-experience article+article{padding:1.4rem 0;border-right:0;border-bottom:1px solid #e3e3e3}.academy-experience article:last-child{border-bottom:0}.academy-card-center{font-size:1.8rem}}</style>
<style>
  .academy-card-center .academy-step{animation:none;opacity:.38;color:#fff;transform:scale(1);transition:color .35s ease,opacity .35s ease,transform .35s ease}
  .academy-card-center .academy-step.is-active{opacity:1;color:var(--color-primary);transform:scale(1.08)}
  .academy-card-center strong:nth-of-type(2), .academy-card-center span:nth-of-type(2){animation-delay:2s}
  .academy-card-center strong:nth-of-type(3), .academy-card-center span:nth-of-type(3){animation-delay:4s}
  .academy-card-center strong:nth-of-type(4), .academy-card-center span:nth-of-type(4){animation-delay:6s}
  .academy-topic-groups{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1.5rem}
  .academy-topic-groups article{padding:1.2rem;border:1px solid #e1e1e1;background:#fff;transition:border-color .25s ease,transform .25s ease}
  .academy-topic-groups article:hover{border-color:var(--color-primary);transform:translateY(-3px)}
  .academy-topic-groups .academy-topic-label{display:block;margin-bottom:.9rem;color:var(--color-primary);font-family:var(--font-heading);font-size:.65rem;letter-spacing:.14em;font-weight:700}
  .academy-topic-groups article>div{display:flex;flex-wrap:wrap;gap:.45rem}
  .academy-topic-groups article>div span{padding:0;border:0;color:#555;font-size:.8rem;line-height:1.35}
  .academy-topic-groups article>div span+span:before{content:'·';margin:0 .45rem;color:var(--color-primary)}
