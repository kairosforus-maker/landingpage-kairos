  .academy-experience-grid.is-carousel .academy-experience-card.is-current .academy-experience-photo .academy-institution-logo{animation:academyLogoArrive .7s .35s both}
  .academy-experience-grid.is-carousel .academy-experience-copy{position:relative;z-index:1;align-self:stretch;display:flex;flex-direction:column;justify-content:center;padding:clamp(1.5rem,4vw,3.5rem);overflow:hidden}
  .academy-experience-grid.is-carousel .academy-experience-copy:before{content:attr(data-gallery-index);position:absolute;z-index:-1;right:-.05em;top:-.22em;color:rgba(255,77,0,.075);font:800 clamp(8rem,18vw,15rem)/1 'Bricolage Grotesque',sans-serif;letter-spacing:-.1em;animation:academyIndexDrift 1.2s cubic-bezier(.2,.7,.2,1) both}
  .academy-experience-grid.is-carousel .academy-experience-copy>span{font:700 .65rem var(--font-heading);letter-spacing:.17em;color:var(--color-primary)}
  .academy-experience-grid.is-carousel .academy-experience-copy h3{max-width:11ch;margin:1.2rem 0 1rem;font:800 clamp(2rem,4vw,3.55rem)/.98 'Bricolage Grotesque',var(--font-heading),sans-serif;letter-spacing:-.055em;color:#121212}
  .academy-experience-grid.is-carousel .academy-experience-copy p{margin:0;color:#585550;font-size:1rem;line-height:1.55}
  .academy-experience-grid.is-carousel .academy-experience-copy small{margin-top:1.1rem;color:#817b73;font-size:.82rem;line-height:1.55}
  .academy-experience-grid.is-carousel .academy-experience-copy>*{animation:none}
  .academy-experience-grid.is-carousel .academy-experience-card.is-current .academy-experience-copy>*{animation:academyTextCascade .65s cubic-bezier(.2,.7,.2,1) both}
  .academy-experience-grid.is-carousel .academy-experience-copy>*:nth-child(2){animation-delay:.12s}.academy-experience-grid.is-carousel .academy-experience-copy>*:nth-child(3){animation-delay:.22s}.academy-experience-grid.is-carousel .academy-experience-copy>*:nth-child(4){animation-delay:.32s}
  .academy-experience-grid.is-carousel .academy-experience-card:hover{transform:none}
  .academy-experience-grid.is-all{gap:0;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #e3e3e3}
  .academy-experience-grid.is-all .academy-experience-card{display:flex;flex-direction:column;border:1px solid #e8e6e3!important;padding:0!important;margin:-1px 0 0 -1px;background:white;transition:transform .35s,box-shadow .35s}
  .academy-experience-grid.is-all .academy-experience-card:hover{z-index:1;transform:translateY(-5px);box-shadow:0 18px 40px rgba(0,0,0,.09)}
  .academy-experience-grid.is-all .academy-experience-photo{height:210px;min-height:0}
  .academy-experience-grid.is-all .academy-experience-copy{padding:1.25rem}
  @keyframes academyStageArrive{from{opacity:0;transform:translateY(18px) scale(.99);filter:blur(4px)}to{opacity:1;transform:translateY(0) scale(1);filter:blur(0)}}
  @keyframes academyImageReveal{from{clip-path:inset(0 100% 0 0);transform:scale(1.09);filter:saturate(.6)}to{clip-path:inset(0 0 0 0);transform:scale(1);filter:saturate(1)}}
  @keyframes academyImageDrift{0%,100%{transform:scale(1)}50%{transform:scale(1.045)}}
  @keyframes academyLogoArrive{from{opacity:0;transform:translateY(16px) rotate(-3deg)}to{opacity:1;transform:translateY(0) rotate(0)}}
  @keyframes academyTextCascade{from{opacity:0;transform:translateY(24px);filter:blur(3px)}to{opacity:1;transform:translateY(0);filter:blur(0)}}
  @keyframes academyIndexDrift{from{opacity:0;transform:translate(22px,18px) rotate(5deg)}to{opacity:1;transform:translate(0,0) rotate(0)}}
  @media(max-width:760px){:global(.academy-gallery-rail){grid-template-columns:repeat(5,minmax(90px,1fr));overflow-x:auto;padding:0 0 .4rem;scroll-snap-type:x mandatory}:global(.academy-gallery-thumb){scroll-snap-align:start}.academy-experience-grid.is-carousel .academy-experience-card.is-current{grid-template-columns:1fr}.academy-experience-grid.is-carousel .academy-experience-photo,.academy-experience-grid.is-carousel .academy-experience-photo>img:first-child{height:clamp(240px,62vw,390px);min-height:0}.academy-experience-grid.is-carousel .academy-experience-copy{min-height:270px;padding:1.5rem}.academy-experience-grid.is-carousel .academy-experience-copy h3{max-width:16ch;font-size:clamp(2rem,9vw,3rem)}.academy-experience-grid.is-all{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:520px){:global(.academy-gallery-toolbar){align-items:flex-start;flex-direction:column}.academy-experience-grid.is-all{grid-template-columns:1fr}.academy-experience-grid.is-carousel .academy-experience-photo .academy-institution-logo{max-width:120px;max-height:54px}.academy-experience-grid.is-carousel .academy-experience-copy{min-height:245px}.academy-experience-grid.is-carousel .academy-experience-copy:before{font-size:9rem}}
  @media(prefers-reduced-motion:reduce){:global(.academy-gallery-thumb i:after){animation:none!important}.academy-experience-grid.is-carousel .academy-experience-card,.academy-experience-grid.is-carousel .academy-experience-photo>img:first-child,.academy-experience-grid.is-carousel .academy-experience-photo .academy-institution-logo,.academy-experience-grid.is-carousel .academy-experience-copy>*{animation:none!important}.academy-experience-grid.is-carousel .academy-experience-copy:before{animation:none!important}}
</style>

<style>
  .academy-cta-actions > a.btn-primary { color: #fff; }
  .academy-cta-actions > a.btn-primary:hover,
  .academy-cta-actions > a.btn-primary:focus-visible { color: var(--color-primary); }
  .academy-cta-actions .academy-whatsapp-link { color: var(--color-primary); }
</style>

<script>
  const academySteps = [...document.querySelectorAll<HTMLElement>('.academy-step')];
  const academyReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let academyActiveStep = 0;

  const setAcademyStep = (index: number) => {
    academySteps.forEach((step, stepIndex) => step.classList.toggle('is-active', stepIndex === index));
  };

  setAcademyStep(academyActiveStep);
  if (!academyReducedMotion) {
    window.setInterval(() => {
      academyActiveStep = (academyActiveStep + 1) % academySteps.length;
      setAcademyStep(academyActiveStep);
    }, 2000);
  }

  const academyExperience = document.querySelector<HTMLElement>('#experiencia .academy-experience-grid');
  if (academyExperience) {
    const experienceCards = [...academyExperience.querySelectorAll<HTMLElement>('.academy-experience-card')];
    const controls = document.createElement('div');
    controls.className = 'academy-experience-controls';
    controls.innerHTML = '<div class="academy-gallery-rail" role="tablist" aria-label="Selecciona una formación"></div>';
    academyExperience.before(controls);
    const rail = controls.querySelector<HTMLElement>('.academy-gallery-rail')!;
    let activeExperience = 0;
    let autoplay: number | undefined;
    const isPlaying = !academyReducedMotion;
    experienceCards.forEach((card, index) => {
      const image = card.querySelector<HTMLImageElement>('.academy-experience-photo > img:first-child');
      const title = card.querySelector('h3')?.textContent?.trim() ?? `Formación ${index + 1}`;
      const thumb = document.createElement('button');
      thumb.type = 'button';
      thumb.className = 'academy-gallery-thumb';
      thumb.setAttribute('role', 'tab');
      thumb.setAttribute('aria-label', `Ver ${title}`);
      thumb.setAttribute('aria-selected', String(index === 0));
      thumb.innerHTML = `<span class="academy-gallery-thumb-image"${image ? ` style="background-image:url('${image.currentSrc || image.src}')"` : ''}></span><span class="academy-gallery-thumb-copy"><small>${String(index + 1).padStart(2, '0')}</small><strong>${title}</strong></span><i aria-hidden="true"></i>`;
      thumb.addEventListener('click', () => {
        activeExperience = index;
        updateExperience();
        if (isPlaying) startAutoplay();
      });
      thumb.addEventListener('keydown', event => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        activeExperience = (index + (event.key === 'ArrowRight' ? 1 : -1) + experienceCards.length) % experienceCards.length;
        rail.querySelectorAll<HTMLButtonElement>('.academy-gallery-thumb')[activeExperience]?.focus();
        updateExperience();
        if (isPlaying) startAutoplay();
      });
      rail.append(thumb);
    });
    const updateExperience = () => {
      experienceCards.forEach((card, index) => {
        card.classList.toggle('is-current', index === activeExperience);
        card.dataset.galleryIndex = String(index + 1).padStart(2, '0');
        const photo = card.querySelector<HTMLElement>('.academy-experience-photo');
        const copy = card.querySelector<HTMLElement>('.academy-experience-copy');
        if (photo) photo.dataset.stageLabel = card.querySelector('.academy-experience-copy > span')?.textContent?.trim() ?? 'Kairos Academy';
        if (copy) copy.dataset.galleryIndex = String(index + 1).padStart(2, '0');
      });
      rail.querySelectorAll<HTMLButtonElement>('.academy-gallery-thumb').forEach((button, index) => {
        button.setAttribute('aria-selected', String(index === activeExperience));
        button.tabIndex = index === activeExperience ? 0 : -1;
      });
    };
    const startAutoplay = () => {
      if (autoplay) window.clearInterval(autoplay);
      autoplay = window.setInterval(() => { activeExperience = (activeExperience + 1) % experienceCards.length; updateExperience(); }, 4800);
    };
    academyExperience.classList.add('is-carousel');
    updateExperience();
    if (isPlaying) startAutoplay();
  }
</script>
