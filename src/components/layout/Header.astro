---
import { getLangFromUrl, content } from '../../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = content[lang].nav;

const home = lang === 'es' ? '/' : '/en';
const base = lang === 'es' ? '/' : '/en/';

const getSwitchUrl = () => {
  const pathname = Astro.url.pathname;
  if (lang === 'es') {
    if (pathname.includes('/quienes-somos')) return '/en/about-us';
    return '/en' + pathname;
  }
  if (pathname.includes('/about-us')) return '/quienes-somos';
  return pathname.replace(/^\/en/, '') || '/';
};

const ctaHref = 'https://cal.com/kairos4us/30min';

const path = Astro.url.pathname;
const isHome = path === '/' || path === '/en' || path === '/en/';

const navItems = [
  { label: t.services, href: `${base}#servicios` },
  { label: t.contact, href: `${base}#contacto` },
  { label: t.about, href: lang === 'es' ? '/quienes-somos' : '/en/about-us' },
];
---

<header class={`header${isHome ? ' header-overlay' : ''}`}>
  <div class="header-container">
    <a href={home} class="logo-link">
      <img src="/logo-isotipo.png" alt="Kairos Logo" class="logo" />
    </a>

    <nav class="nav-links">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="header-right">
      <div class="lang-switcher">
        <a href={lang === 'es' ? '#' : getSwitchUrl()} class={`lang-text ${lang === 'es' ? 'active' : ''}`}>ES</a>
        <span class="lang-divider">/</span>
        <a href={lang === 'en' ? '#' : getSwitchUrl()} class={`lang-text ${lang === 'en' ? 'active' : ''}`}>EN</a>
      </div>

      <button class="menu-toggle" id="menuToggle" aria-label="Menú" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" id="mobileMenu">
    {navItems.map((item) => (
      <a href={item.href} class="mobile-link">{item.label}</a>
    ))}
    <a
      href={ctaHref}
      onclick="event.preventDefault();"
      data-cal-link="kairos4us/30min"
      data-cal-namespace="30min"
      data-cal-config='{"layout":"month_view"}'
      class="mobile-cta"
    >{t.cta}</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    toggle.classList.toggle('is-open', !!open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.remove('open');
      toggle?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .header {
    background-color: var(--color-dark);
    padding: 1.5rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background-color: transparent;
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .logo-link {
    flex-shrink: 0;
  }

  .logo {
    height: 36px;
    width: auto;
    display: block;
  }

  /* Nav links — centered, white/grey, quiet */
  .nav-links {
    display: flex;
    gap: 3rem;
    justify-content: center;
    flex: 1;
  }

  .nav-links a {
    color: rgba(255,255,255,0.78);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--color-white);
  }

  /* Right side */
  .header-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  .lang-text {
    color: rgba(255,255,255,0.5) !important;
    text-decoration: none !important;
    transition: color 0.3s ease;
  }

  .lang-text:hover {
    color: rgba(255,255,255,0.7) !important;
  }

  .lang-text.active {
    color: var(--color-primary) !important;
    pointer-events: none;
  }

  .lang-divider {
    color: rgba(255,255,255,0.2) !important;
    font-weight: 400;
  }

  /* Hamburger */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .menu-toggle span {
    display: block;
    height: 1.5px;
    width: 22px;
    background-color: rgba(255,255,255,0.7);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .menu-toggle.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-toggle.is-open span:nth-child(2) { opacity: 0; }
  .menu-toggle.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background-color: var(--color-dark);
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 0 2rem;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, padding 0.35s ease;
  }

  .mobile-menu.open {
    display: flex;
    max-height: 500px;
    padding: 1.5rem 2rem 2rem;
  }

  .mobile-link {
    color: rgba(255,255,255,0.7);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 1.05rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    text-decoration: none;
    transition: color 0.2s;
  }

  .mobile-link:hover {
    color: var(--color-white);
  }

  .mobile-cta {
    margin-top: 1.5rem;
    text-align: center;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.85rem 1.4rem;
    border-radius: 50px;
    text-decoration: none;
    transition: background 0.3s, color 0.3s;
  }

  .mobile-cta:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }

  @media (max-width: 900px) {
    .header-container {
      padding: 0 1.5rem;
    }

    .nav-links { display: none; }
    .menu-toggle { display: flex; }
  }
</style>
