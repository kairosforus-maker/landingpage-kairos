---
import { getLangFromUrl, content } from '../../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = content[lang].about.audience;
---

<section class="about-audience section-padding">
  <div class="audience-header anim-fade-up">
    <span class="tag-subtitle">{t.tag}</span>
    <h2 class="section-title">{t.title}</h2>
  </div>

  <div class="audience-grid">
    <!-- Leaders Card -->
    <div class="audience-card glass anim-fade-up anim-delay-1">
      <!-- Imagen temporal (Unsplash, CC0) -->
      <img
        class="audience-image"
        src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&w=1000&q=80"
        alt={t.leaders.title}
        loading="lazy"
      />
      <div class="card-content">
        <h3 class="card-title">{t.leaders.title}</h3>
        <p class="card-desc">{t.leaders.desc}</p>
      </div>
    </div>

    <!-- Organizations Card -->
    <div class="audience-card glass anim-fade-up anim-delay-2">
      <!-- Imagen temporal (Unsplash, CC0) -->
      <img
        class="audience-image"
        src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1000&q=80"
        alt={t.orgs.title}
        loading="lazy"
      />
      <div class="card-content">
        <h3 class="card-title">{t.orgs.title}</h3>
        <p class="card-desc">{t.orgs.desc}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about-audience {
    background-color: var(--color-dark);
    position: relative;
    overflow: hidden;
  }

  /* Decorative background element */
  .about-audience::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -10%;
    width: 60%;
    height: 150%;
    background: radial-gradient(circle, rgba(255, 77, 0, 0.05) 0%, rgba(10, 10, 10, 0) 70%);
    z-index: 0;
  }

  .audience-header {
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    z-index: 1;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
  }

  .audience-grid {
    display: flex;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .audience-card {
    flex: 1;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.4s ease, border-color 0.4s ease;
  }

  .audience-card:hover {
    transform: translateY(-10px);
    border-color: rgba(255, 77, 0, 0.3);
  }

  .audience-image {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: cover;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .card-content {
    padding: 3rem 2.5rem;
  }

  .card-title {
    color: var(--color-primary);
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .card-desc {
    color: #a0a0a0;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .audience-grid {
      flex-direction: column;
    }
  }
</style>
